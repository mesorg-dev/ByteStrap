// Дизайн-токены ByteStrap: тёмная тема в духе Lunar Client.
// Цвета совпадают с egui-темой (src/theme.rs) — переход без визуального слома.

export global Theme {
    in-out property <color> bg: #0a0a0b;
    in-out property <color> sidebar: #0d0d0f;
    in-out property <color> panel: #121214;
    in-out property <color> panel-alt: #0e0e11;
    in-out property <color> field: #0e0e10;
    in-out property <color> line: #2a2a2e;
    in-out property <color> line-soft: #1c1c1f;
    in-out property <color> fg: #f2f2ef;
    in-out property <color> fg-dim: #98989e;
    in-out property <color> fg-dimmer: #5c5c62;
    in-out property <color> good: #78dc82;
    in-out property <color> bad: #ff8087;
    in-out property <color> warn: #ffc857;
    in-out property <color> accent: #78dc82;
    in-out property <color> on-accent: #0a0a0b;

    in-out property <length> r-card: 8px;
    in-out property <length> r-soft: 6px;

    in-out property <string> font: "Inter";
    in-out property <string> font-mono: "JetBrains Mono";
    in-out property <string> font-display: "Unbounded";

    in-out property <length> titlebar-h: 44px;
    in-out property <length> sidebar-w: 236px;
    in-out property <length> nav-item-h: 46px;
    in-out property <length> nav-step: 50px;
}
