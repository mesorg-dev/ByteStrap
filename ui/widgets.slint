// Библиотека виджетов ByteStrap: чистый тёмный стиль.
// Матовые слои, тонкие 1px полупрозрачные обводки, кнопки-таблетки,
// плавная анимация переходов и аккуратные микро-взаимодействия.

import { Theme } from "theme.slint";
import { Snd } from "snd.slint";
import { IconRefresh, IconFolder, IconCopy, IconChevronDown, IconChevronUp } from "icons.slint";

// ===== Появление страницы: fade + лёгкий сдвиг вверх =====
export component PageFade inherits Rectangle {
    property <bool> shown: false;
    opacity: root.shown ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }
    y: root.shown ? 0px : 6px;
    animate y { duration: 160ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    init => { root.shown = true; }
}

// ===== Карточка: приподнятая поверхность без теней =====
export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.border;
}

// ===== Кнопка (таблетка) =====
// kind: 0 — Primary (лавандовый акцент), 1 — Secondary (матовая поверхность + обводка),
//       2 — Ghost / Subtle (прозрачная / активная), 3 — Danger (приглушённо-красная).
export component Btn inherits Rectangle {
    in-out property <string> label;
    in-out property <int> kind: 0;
    in-out property <bool> enabled: true;
    /// Подсветка активного состояния (например, для табов или фильтров).
    in-out property <bool> active: false;
    callback clicked;

    height: 34px;
    border-radius: self.height / 2;

    background: !root.enabled
        ? (root.kind == 0 ? Theme.accent : (root.kind == 1 ? #1B1E2A : (root.kind == 3 ? #F871711A : (root.active ? #96A6FF1F : #FFFFFF08))))
        : root.kind == 0
            ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent))
            : root.kind == 1
                ? (touch.pressed ? #252A3B : (touch.has-hover ? Theme.surface-hover : #1B1E2A))
                : root.kind == 3
                    ? (touch.pressed ? #F8717133 : (touch.has-hover ? #F8717126 : #F871711A))
                    : root.active
                        ? (touch.pressed ? #96A6FF33 : (touch.has-hover ? #96A6FF29 : #96A6FF1F))
                        : (touch.pressed ? #FFFFFF1A : (touch.has-hover ? #FFFFFF12 : #FFFFFF08));
    animate background { duration: Theme.t-fast; easing: ease-out; }

    border-width: root.kind == 0 ? 0px : 1px;
    border-color: root.kind == 1
        ? (touch.has-hover && root.enabled ? Theme.border-hover : Theme.border)
        : root.kind == 3
            ? (touch.has-hover && root.enabled ? #F8717166 : #F8717140)
            : root.active
                ? Theme.border-accent
                : (touch.has-hover && root.enabled ? #FFFFFF26 : #FFFFFF14);
    animate border-color { duration: Theme.t-fast; easing: ease-out; }

    opacity: root.enabled ? 1.0 : 0.45;

    property <length> pad-h: root.height >= 38px ? 18px : 16px;

    HorizontalLayout {
        padding-left: root.pad-h;
        padding-right: root.pad-h;
        alignment: center;

        Text {
            text: root.label;
            font-family: Theme.font;
            font-size: 12.5px;
            font-weight: 600;
            color: root.kind == 0
                ? Theme.on-accent
                : root.kind == 3
                    ? #FCA5A5
                    : root.active
                        ? Theme.accent
                        : Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Snd.play(0);
            root.clicked();
        }
    }
}

// ===== Иконочная кнопка (круглая / таблетка 28×28) =====
// icon: 0 — обновить, 1 — папка, 2 — копировать.
export component IconBtn inherits Rectangle {
    in-out property <int> icon: 0;
    in-out property <string> tip;
    in-out property <bool> enabled: true;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.border-hover : Theme.border;
    background: touch.pressed && root.enabled ? #2A2F42
        : touch.has-hover && root.enabled ? Theme.surface-hover
        : Theme.surface-2;
    animate background { duration: Theme.t-fast; easing: ease-out; }
    animate border-color { duration: Theme.t-fast; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.45;

    if root.icon == 0 : IconRefresh {
        x: (parent.width - 14px) / 2;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        c: touch.has-hover && root.enabled ? Theme.text-primary : Theme.text-secondary;
    }
    if root.icon == 1 : IconFolder {
        x: (parent.width - 14px) / 2;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        c: touch.has-hover && root.enabled ? Theme.text-primary : Theme.text-secondary;
    }
    if root.icon == 2 : IconCopy {
        x: (parent.width - 14px) / 2;
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        c: touch.has-hover && root.enabled ? Theme.text-primary : Theme.text-secondary;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Snd.play(0);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
}

// ===== Стрелочная кнопка-глиф 28×28 =====
export component GlyphBtn inherits Rectangle {
    in-out property <string> glyph;
    in-out property <bool> enabled: true;
    in-out property <string> tip;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.border-hover : Theme.border;
    background: touch.pressed && root.enabled ? #2A2F42
        : touch.has-hover && root.enabled ? Theme.surface-hover
        : Theme.surface-2;
    animate background { duration: Theme.t-fast; easing: ease-out; }
    animate border-color { duration: Theme.t-fast; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-family: Theme.font-mono;
        font-size: 13px;
        color: root.enabled
            ? (touch.has-hover ? Theme.text-primary : Theme.text-secondary)
            : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Snd.play(0);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
}

// ===== Поле ввода (TextField) =====
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in-out property <string> placeholder;
    in-out property <bool> enabled: true;
    callback accepted;
    callback edited;

    height: 36px;
    border-radius: Theme.r-md;
    background: #12141C;
    border-width: 1px;
    border-color: input.has-focus
        ? Theme.accent
        : (touch.has-hover && root.enabled ? Theme.border-hover : Theme.border);
    animate border-color { duration: Theme.t-fast; easing: ease-out; }

    input := TextInput {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        enabled: root.enabled;
        vertical-alignment: center;
        single-line: true;
        font-size: 12.5px;
        font-family: Theme.font;
        color: Theme.text-primary;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    /// Фокус + выделение всего текста.
    public function focus-select-all() {
        input.focus();
        input.select-all();
    }

    Text {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        visible: root.text == "";
        text: root.placeholder;
        font-size: 12.5px;
        font-family: Theme.font;
        color: Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
}

// ===== Тумблер (Toggle 40×22) =====
export component Toggle inherits Rectangle {
    in-out property <bool> on: false;
    in-out property <bool> enabled: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : #232736;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    animate background, border-color { duration: Theme.t-fast; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.45;

    knob := Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        animate x { duration: Theme.t-fast; easing: ease-out; }
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Theme.on-accent : Theme.text-secondary;
        animate background { duration: Theme.t-fast; easing: ease-out; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Snd.play(1);
            root.toggled(!root.on);
        }
    }
}

// ===== Прогресс-бар (0..1) =====
export component ProgressBar inherits Rectangle {
    in-out property <float> value: 0;

    height: 6px;
    border-radius: 3px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width * min(max(root.value, 0.0), 1.0);
        height: parent.height;
        border-radius: 3px;
        background: Theme.accent;
        animate width { duration: Theme.t-fast; easing: ease-out; }
    }
}

// ===== Точка статуса (StatusDot / бейдж) =====
// kind: 0 — неактивно (muted), 1 — готово (success), 2 — занято (warning), 3 — ошибка (danger).
export component StatusDot inherits Rectangle {
    in-out property <int> kind: 0;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.kind == 1 ? Theme.success
        : root.kind == 2 ? Theme.warning
        : root.kind == 3 ? Theme.danger
        : Theme.text-muted;
    animate background { duration: Theme.t-fast; }

    // Занято — деликатная пульсация
    opacity: root.kind == 2 ? (0.55 + 0.45 * Theme.twinkle(3.7, animation-tick() / 1ms)) : 1.0;

    drop-shadow-blur: root.kind == 1 ? 4px : 0px;
    drop-shadow-color: #4ADE8033;
}

// ===== Строка настройки: заголовок (+описание) слева, тумблер справа =====
export component OptionRow inherits Rectangle {
    in-out property <string> title;
    in-out property <string> desc: "";
    in-out property <bool> checked: false;
    in-out property <bool> enabled: true;
    callback toggled(bool);

    min-height: root.desc == "" ? 32px : 44px;
    border-radius: Theme.r-md;
    background: touch.has-hover && root.enabled ? #FFFFFF05 : transparent;
    animate background { duration: Theme.t-fast; }

    HorizontalLayout {
        width: 100%;
        spacing: 12px;
        padding-left: 4px;
        padding-right: 4px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-family: Theme.font;
                font-size: root.desc == "" ? 12.5px : 13px;
                font-weight: root.desc == "" ? 400 : 600;
                color: Theme.text-primary;
                overflow: elide;
            }

            if root.desc != "" : Text {
                text: root.desc;
                font-family: Theme.font;
                font-size: 11.5px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;

            Toggle {
                on: root.checked;
                enabled: root.enabled;
                toggled(v) => { root.toggled(v); }
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Snd.play(1);
            root.toggled(!root.checked);
        }
    }
}

// ===== Оверлей дропдаунов (маршрутизация выбора через Dd) =====
export global Dd {
    in-out property <bool> open: false;
    /// Позиция списка (левый верх комбо) и его ширина.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> w;
    /// Маршрутизация выбора: 0..99 — пресеты флагов, 100 — профили флагов,
    /// 200 — профили модов, 300+ — настройки клиента.
    in-out property <int> owner: -1;
    in-out property <[string]> items;
    in-out property <int> selected: -1;
    callback pick(int);
}

// ===== Выпадающий список (Combo) =====
export component Combo inherits Rectangle {
    in-out property <[string]> items;
    in-out property <int> selected: -1;
    in-out property <string> current-text;
    in-out property <int> dd-id: 0;
    in-out property <bool> enabled: true;
    callback pick(int);
    /// Состояние списка изменилось (для высоты скролла у вызывающего).
    callback open-changed(bool);

    property <bool> opened: Dd.open && Dd.owner == root.dd-id;

    height: 34px;
    border-radius: Theme.r-md;
    background: #12141C;
    border-width: 1px;
    border-color: root.opened
        ? Theme.accent
        : (touch.has-hover && root.enabled ? Theme.border-hover : Theme.border);
    animate border-color { duration: Theme.t-fast; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        x: 12px;
        y: 0;
        width: parent.width - 34px;
        height: parent.height;
        text: root.current-text;
        font-family: Theme.font;
        font-size: 12px;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.opened : IconChevronUp {
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        c: Theme.accent;
    }
    if !root.opened : IconChevronDown {
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        c: touch.has-hover && root.enabled ? Theme.text-primary : Theme.text-secondary;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Snd.play(0);
            if root.opened {
                Dd.open = false;
                root.open-changed(false);
            } else {
                Dd.items = root.items;
                Dd.selected = root.selected;
                Dd.w = self.width;
                Dd.x = self.absolute-position.x;
                Dd.y = self.absolute-position.y + self.height;
                Dd.owner = root.dd-id;
                Dd.open = true;
                root.open-changed(true);
            }
        }
    }
}

// ===== Слайдер: значение 0..1 =====
export component Slider inherits Rectangle {
    in-out property <float> value: 0.7;
    in-out property <bool> enabled: true;
    callback changed();
    callback released();

    horizontal-stretch: 1;
    min-width: 80px;
    height: 26px;
    clip: false;

    property <float> v: min(max(root.value, 0.0), 1.0);
    property <length> knob-size: 14px;
    property <length> track-w: max(1px, self.width - root.knob-size);
    property <length> knob-x: root.v * root.track-w;
    property <bool> dragging: false;
    property <float> drag-start-val: 0.0;

    // Фоновая дорожка трека
    Rectangle {
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: #232736;
    }

    // Заполнение активной части от левого края до центра бегунка
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: min(parent.width, root.knob-x + root.knob-size / 2);
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? Theme.accent : #5A5F75;
    }

    // Бегунок (Knob)
    knob := Rectangle {
        x: root.knob-x;
        y: (parent.height - self.height) / 2;
        width: root.knob-size;
        height: root.knob-size;
        border-radius: root.knob-size / 2;
        background: root.enabled ? Theme.accent : #5A5F75;
        border-width: 1px;
        border-color: root.dragging || (touch.has-hover && root.enabled) ? #FFFFFF : #FFFFFF88;
        drop-shadow-blur: root.dragging ? 6px : 2px;
        drop-shadow-color: Theme.glow;
        animate drop-shadow-blur { duration: 100ms; }
    }

    // Зона ввода
    touch := TouchArea {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: parent.height + 16px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;

        pointer-event(event) => {
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.dragging = true;
                Snd.play(1);
                let rel-x = touch.mouse-x;
                if (rel-x < root.knob-x || rel-x > root.knob-x + root.knob-size) {
                    let new-v = min(max((rel-x - root.knob-size / 2) / root.track-w, 0.0), 1.0);
                    root.value = new-v;
                    root.drag-start-val = new-v;
                    root.changed();
                } else {
                    root.drag-start-val = root.v;
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.dragging = false;
                    root.released();
                }
            }
        }

        moved => {
            if (root.dragging) {
                let delta = (touch.mouse-x - touch.pressed-x) / root.track-w;
                let new-v = min(max(root.drag-start-val + delta, 0.0), 1.0);
                if (new-v != root.value) {
                    root.value = new-v;
                    root.changed();
                }
            }
        }
    }
}
