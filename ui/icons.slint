// Линейные иконки 18×18 (перенос src/ui/icons.rs в Slint Path).
// Координаты в сетке 18×18; viewbox даёт точное масштабирование.

import { Theme } from "theme.slint";

export component IconHome inherits Rectangle {
    in-out property <color> c: Theme.fg-dim;
    width: 18px;
    height: 18px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: root.c;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M1.8 8.2 L9 1.5 L16.2 8.2 M3.9 7.4 L3.9 16.5 L14.1 16.5 L14.1 7.4 M7.3 16.5 L7.3 11.4 L10.7 11.4 L10.7 16.5";
    }
}

