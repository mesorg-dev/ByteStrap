// Кастомный titlebar для no-frame окна: звезда-логотип, статус, кнопки окна.
// Перетаскивание — через колбэк контроллеру (winit drag_window),
// двойной клик — свернуть/развернуть.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { Snd } from "snd.slint";
import { IconStar } from "icons.slint";

component WinBtn inherits Rectangle {
    in-out property <string> glyph;
    in-out property <bool> danger: false;
    in-out property <string> tip;
    callback clicked;

    width: 46px;
    height: Theme.titlebar-h;
    background: touch.has-hover
        ? (root.danger ? #e2959f26 : Theme.glass-hover)
        : transparent;
    animate background { duration: Theme.t-fast; }

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-size: 13px;
        color: touch.has-hover
            ? (root.danger ? Theme.bad : Theme.fg)
            : Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            Snd.play(0);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
}

export component TitleBar inherits Rectangle {
    in-out property <string> status;
    callback win-min();
    callback win-max();
    /// Начать перетаскивание окна (winit).
    callback drag();
    callback close-request();

    height: Theme.titlebar-h;
    background: transparent;

    // Логотип: звезда в стеклянном квадрате с холодным ореолом.
    Rectangle {
        x: 14px;
        y: 6px;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #ffffff10;
        border-width: 1px;
        border-color: #ffffff22;

        IconStar {
            x: (parent.width - 14px) / 2;
            y: (parent.height - 14px) / 2;
            width: 14px;
            height: 14px;
            c: #ffffff;
        }
    }

    Text {
        x: 56px;
        y: 7px;
        text: "ByteStrap";
        font-family: Theme.font-display;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: Theme.fg;
    }

    Text {
        x: 57px;
        y: 25px;
        text: T.app_sub;
        font-family: Theme.font-mono;
        font-size: 8.5px;
        letter-spacing: 2px;
        color: Theme.fg-dimmer;
    }

    // Статус по центру.
    Text {
        x: 280px;
        y: 0;
        width: parent.width - 560px;
        height: parent.height;
        visible: root.status != "";
        text: root.status;
        font-family: Theme.font-mono;
        font-size: 11.5px;
        color: Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // Зона перетаскивания (под кнопками окна).
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 138px;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.drag();
            }
        }
        double-clicked => { root.win-max(); }
    }

    // Кнопки окна.
    WinBtn {
        x: parent.width - 138px;
        y: 0;
        glyph: "—";
        tip: T.win_min;
        clicked => { root.win-min(); }
    }
    WinBtn {
        x: parent.width - 92px;
        y: 0;
        glyph: "▢";
        tip: T.win_max;
        clicked => { root.win-max(); }
    }
    WinBtn {
        x: parent.width - 46px;
        y: 0;
        glyph: "✕";
        danger: true;
        tip: T.win_close;
        clicked => { root.close-request(); }
    }
}
