// Верхняя панель окна (TitleBar): компактная высота 54px,
// логотип и индикатор статуса слева, плавающая капсула навигации по центру,
// кнопки управления окном справа.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { Snd } from "snd.slint";
import { StatusDot } from "widgets.slint";
import { IconStar, IconCross, IconHome, IconGamepad, IconSliders, IconWrench, IconTerminal, IconGear, IconInfo } from "icons.slint";

// Кнопка управления окном (минимизировать, развернуть/восстановить, закрыть)
component WinBtn inherits Rectangle {
    in-out property <int> kind: 0; // 0=min, 1=max, 2=restore, 3=close
    in-out property <string> tip: "";
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: touch.has-hover
        ? (root.kind == 3 ? #F8717126 : #ffffff0f)
        : transparent;
    animate background { duration: Theme.t-fast; }

    if root.kind == 0 : Rectangle {
        width: 10px;
        height: 1.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        border-radius: 0.75px;
    }

    if root.kind == 1 : Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1.2px;
        border-color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        border-radius: 2px;
    }

    if root.kind == 2 : Text {
        width: 100%;
        height: 100%;
        text: "❐";
        font-size: 11px;
        color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.kind == 3 : IconCross {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        c: touch.has-hover ? #FCA5A5 : Theme.text-secondary;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Snd.play(2);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
}

// Элемент вкладки в плавающей капсуле
component NavTab inherits Rectangle {
    in-out property <int> kind;
    in-out property <bool> active: false;
    in-out property <string> label;
    callback clicked;

    height: 32px;
    border-radius: 16px;
    background: root.active
        ? Theme.surface-hover
        : (touch.has-hover ? #ffffff0d : transparent);
    border-width: root.active ? 1px : 0px;
    border-color: #ffffff1a;
    animate background { duration: Theme.t-fast; }

    HorizontalLayout {
        padding-left: root.active ? 12px : 8px;
        padding-right: root.active ? 12px : 8px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - 16px) / 2;

            if root.kind == 0 : IconHome {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
            if root.kind == 1 : IconGamepad {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
            if root.kind == 2 : IconSliders {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
            if root.kind == 4 : IconWrench {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
            if root.kind == 5 : IconTerminal {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
            if root.kind == 6 : IconGear {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
            if root.kind == 7 : IconInfo {
                width: 16px;
                height: 16px;
                c: root.active ? Theme.accent : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
            }
        }

        if root.active : Text {
            text: root.label;
            font-family: Theme.font;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Snd.play(2);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.label}");
        }
    }
}

export component TitleBar inherits Rectangle {
    in-out property <int> page: 0;
    in-out property <bool> show-logs: true;
    in-out property <int> status-dot: 0;
    in-out property <string> status: "";
    in-out property <bool> is-maximized: false;

    callback navigate(int);
    callback win-min();
    callback win-max();
    callback drag();
    callback close-request();

    height: Theme.titlebar-h;
    background: transparent;

    // Фоновая зона перетаскивания окна (под всеми элементами управления)
    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if (self.pressed) {
                root.drag();
            }
        }
        double-clicked => { root.win-max(); }
    }

    // Верхний контент: левая часть (логотип + статус), центр (капсула), правая часть (кнопки)
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;

        // Слева: квадратный логотип + компактная точка статуса
        HorizontalLayout {
            width: 140px;
            alignment: start;
            spacing: 10px;

            Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - 32px) / 2;
                border-radius: 10px;
                background: Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border;

                IconStar {
                    x: (parent.width - 16px) / 2;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    c: Theme.accent;
                }
            }

            if root.status-dot > 0 : Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - 8px) / 2;
                StatusDot {
                    kind: root.status-dot;
                }
                if root.status != "" : TouchArea {
                    width: 100%;
                    height: 100%;
                    Tooltip {
                        text: @markdown("\{root.status}");
                    }
                }
            }
        }

        // Пространство слева от капсулы для центрирования
        Rectangle { horizontal-stretch: 1; }

        // По центру: плавающая капсула навигации
        Rectangle {
            horizontal-stretch: 0;
            y: (parent.height - 38px) / 2;
            height: 38px;
            border-radius: 19px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                NavTab {
                    kind: 0;
                    label: T.nav_home;
                    active: root.page == 0;
                    clicked => { root.navigate(0); }
                }
                NavTab {
                    kind: 1;
                    label: T.nav_games;
                    active: root.page == 1;
                    clicked => { root.navigate(1); }
                }
                NavTab {
                    kind: 2;
                    label: T.nav_flags;
                    active: root.page == 2;
                    clicked => { root.navigate(2); }
                }
                NavTab {
                    kind: 4;
                    label: T.nav_mods;
                    active: root.page == 4;
                    clicked => { root.navigate(4); }
                }
                if root.show-logs : NavTab {
                    kind: 5;
                    label: T.nav_logs;
                    active: root.page == 5;
                    clicked => { root.navigate(5); }
                }
                NavTab {
                    kind: 6;
                    label: T.nav_settings;
                    active: root.page == 6;
                    clicked => { root.navigate(6); }
                }
                NavTab {
                    kind: 7;
                    label: T.nav_about;
                    active: root.page == 7;
                    clicked => { root.navigate(7); }
                }
            }
        }

        // Пространство справа от капсулы для центрирования
        Rectangle { horizontal-stretch: 1; }

        // Справа: трио кнопок управления окном
        HorizontalLayout {
            width: 140px;
            alignment: end;
            spacing: 6px;

            WinBtn {
                y: (parent.height - 28px) / 2;
                kind: 0;
                tip: T.win_min;
                clicked => { root.win-min(); }
            }
            WinBtn {
                y: (parent.height - 28px) / 2;
                kind: root.is-maximized ? 2 : 1;
                tip: root.is-maximized ? T.win_restore : T.win_max;
                clicked => { root.win-max(); }
            }
            WinBtn {
                y: (parent.height - 28px) / 2;
                kind: 3;
                tip: T.win_close;
                clicked => { root.close-request(); }
            }
        }
    }
}
