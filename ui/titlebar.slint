// Кастомный titlebar для no-frame окна: логотип, статус, кнопки окна.
// Перетаскивание — через колбэк контроллеру (winit drag_window),
// двойной клик — свернуть/развернуть.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";

component WinBtn inherits Rectangle {
    in-out property <string> glyph;
    in-out property <bool> danger: false;
    in-out property <string> tip;
    callback clicked;

    width: 46px;
    height: Theme.titlebar-h;
    background: touch.has-hover
        ? (root.danger ? Theme.bad : Theme.line-soft)
        : transparent;
    animate background { duration: 100ms; }

    Text {
        width: 100%;
        height: 100%;
        text: root.glyph;
        font-size: 13px;
        color: touch.has-hover ? Theme.fg : Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
}

export component TitleBar inherits Rectangle {
    in-out property <string> status;
    callback win-min();
    callback win-max();
    /// Начать перетаскивание окна (winit).
    callback drag();
    callback close-request();

    height: Theme.titlebar-h;
    background: Theme.bg;

    // Логотип.
    Rectangle {
        x: 16px;
        y: 5px;
        width: 34px;
        height: 34px;
        border-radius: 7px;
        background: Theme.fg;

        Text {
            width: 100%;
            height: 100%;
            text: "B";
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: 15px;
            color: Theme.bg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 60px;
        y: 7px;
        text: "ByteStrap";
        font-size: 13px;
        font-weight: 600;
        color: Theme.fg;
    }

    Text {
        x: 60px;
        y: 25px;
        text: T.app_sub;
        font-family: Theme.font-mono;
        font-size: 9px;
        letter-spacing: 1px;
        color: Theme.fg-dimmer;
    }

    // Статус по центру.
    Text {
        x: 280px;
        y: 0;
        width: parent.width - 560px;
        height: parent.height;
        visible: root.status != "";
        text: root.status;
        font-family: Theme.font-mono;
        font-size: 11.5px;
        color: Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    // Зона перетаскивания (под кнопками окна).
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width - 138px;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.drag();
            }
        }
        double-clicked => { root.win-max(); }
    }

    // Кнопки окна.
    WinBtn {
        x: parent.width - 138px;
        y: 0;
        glyph: "—";
        tip: T.win_min;
        clicked => { root.win-min(); }
    }
    WinBtn {
        x: parent.width - 92px;
        y: 0;
        glyph: "▢";
        tip: T.win_max;
        clicked => { root.win-max(); }
    }
    WinBtn {
        x: parent.width - 46px;
        y: 0;
        glyph: "✕";
        danger: true;
        tip: T.win_close;
        clicked => { root.close-request(); }
    }
}
