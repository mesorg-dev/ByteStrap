// Верхняя панель окна (TitleBar): компактная высота 54px,
// логотип и индикатор статуса слева, плавающая капсула навигации по центру,
// кнопки управления окном справа.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { Snd } from "snd.slint";
import { StatusDot } from "widgets.slint";
import { IconStar, IconCross, IconHome, IconGamepad, IconSliders, IconWrench, IconTerminal, IconGear, IconInfo, IconChat } from "icons.slint";

// Кнопка управления окном (минимизировать, развернуть/восстановить, закрыть)
component WinBtn inherits Rectangle {
    in-out property <int> kind: 0; // 0=min, 1=max, 2=restore, 3=close
    in-out property <string> tip: "";
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: touch.has-hover
        ? (root.kind == 3 ? #F8717126 : #ffffff0f)
        : transparent;
    animate background { duration: Theme.t-fast; }

    if root.kind == 0 : Rectangle {
        width: 10px;
        height: 1.5px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        border-radius: 0.75px;
    }

    if root.kind == 1 : Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1.2px;
        border-color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        border-radius: 2px;
    }

    if root.kind == 2 : Text {
        width: 100%;
        height: 100%;
        text: "❐";
        font-size: 11px;
        color: touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.kind == 3 : IconCross {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        c: touch.has-hover ? #FCA5A5 : Theme.text-secondary;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Snd.play(2);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.tip}");
        }
    }
}

// Элемент вкладки в плавающей капсуле
component NavTab inherits Rectangle {
    in-out property <int> kind;
    in-out property <bool> active: false;
    in-out property <string> label;
    in-out property <bool> shown: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked;

    visible: root.shown;
    height: 32px;
    clip: true;
    width: !root.shown ? 0px : (root.active ? (34px + txt.preferred-width + 12px) : 34px);
    animate width { duration: 280ms; easing: cubic-bezier(0.34, 1.25, 0.64, 1); }

    // Фиксированная иконка (не дёргается при расширении таба)
    Rectangle {
        x: 9px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;

        property <color> icon-c: root.active 
            ? Theme.accent 
            : (touch.has-hover ? Theme.text-primary : Theme.text-secondary);
        animate icon-c { duration: 180ms; }

        if root.kind == 0 : IconHome { width: 16px; height: 16px; c: parent.icon-c; }
        if root.kind == 1 : IconGamepad { width: 16px; height: 16px; c: parent.icon-c; }
        if root.kind == 2 : IconSliders { width: 16px; height: 16px; c: parent.icon-c; }
        if root.kind == 4 : IconWrench { width: 16px; height: 16px; c: parent.icon-c; }
        if root.kind == 5 : IconTerminal { width: 16px; height: 16px; c: parent.icon-c; }
        if root.kind == 6 : IconGear { width: 16px; height: 16px; c: parent.icon-c; }
        if root.kind == 7 : IconInfo { width: 16px; height: 16px; c: parent.icon-c; }
    }

    // Текст вкладки выезжает из-под маски clip: true
    txt := Text {
        x: 31px;
        y: (parent.height - self.height) / 2;
        opacity: root.active ? 1.0 : 0.0;
        animate opacity { duration: 200ms; easing: ease-out; }

        text: root.label;
        font-family: Theme.font;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-primary;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Snd.play(2);
            root.clicked();
        }
        Tooltip {
            text: @markdown("\{root.label}");
        }
    }
}

export component TitleBar inherits Rectangle {
    in-out property <int> page: 0;
    in-out property <bool> show-logs: true;
    in-out property <int> status-dot: 0;
    in-out property <string> status: "";
    in-out property <bool> is-maximized: false;
    in-out property <bool> chat-open: false;
    in-out property <int> chat-peers-count: 0;
    in-out property <bool> chat-has-unread: false;
    in-out property <bool> chat-enabled: true;

    callback navigate(int);
    callback chat-toggle();
    callback win-min();
    callback win-max();
    callback drag();
    callback close-request();

    height: Theme.titlebar-h;
    background: transparent;

    // Фоновая зона перетаскивания окна (под всеми элементами управления)
    TouchArea {
        width: 100%;
        height: 100%;
        moved => {
            if (self.pressed) {
                root.drag();
            }
        }
        double-clicked => { root.win-max(); }
    }

    // Слева: квадратный логотип + компактная точка статуса
    HorizontalLayout {
        x: 14px;
        y: 0;
        width: 140px;
        height: 100%;
        alignment: start;
        spacing: 10px;

        Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - 32px) / 2;
            border-radius: 10px;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: Theme.border;

            IconStar {
                x: (parent.width - 16px) / 2;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                c: Theme.accent;
            }
        }

        if root.status-dot > 0 : Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - 8px) / 2;
            StatusDot {
                kind: root.status-dot;
            }
            if root.status != "" : TouchArea {
                width: 100%;
                height: 100%;
                Tooltip {
                    text: @markdown("\{root.status}");
                }
            }
        }
    }

    // Справа: кнопка чата + трио кнопок управления окном
    HorizontalLayout {
        x: parent.width - self.width - 14px;
        y: 0;
        width: 210px;
        height: 100%;
        alignment: end;
        spacing: 6px;

        // Компактная кнопка-капсула чата
        if root.chat-enabled : Rectangle {
            y: (parent.height - 28px) / 2;
            height: 28px;
            border-radius: 14px;
            background: root.chat-open ? #96A6FF24
                : (chat-touch.has-hover ? #ffffff12 : Theme.surface-2);
            border-width: 1px;
            border-color: root.chat-open ? Theme.border-accent
                : (chat-touch.has-hover ? Theme.border-hover : Theme.border);
            animate background, border-color { duration: Theme.t-fast; }

            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 5px;
                alignment: center;

                IconChat {
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    c: root.chat-open || root.chat-peers-count > 0 ? Theme.accent
                        : (chat-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                }

                if root.chat-peers-count > 0 : Rectangle {
                    y: (parent.height - self.height) / 2;
                    min-width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: Theme.accent;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        alignment: center;

                        Text {
                            text: root.chat-peers-count;
                            font-family: Theme.font-mono;
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.on-accent;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Маленькая яркая точка непрочитанных сообщений
            if root.chat-has-unread : Rectangle {
                x: parent.width - 7px;
                y: 1px;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.success;
                border-width: 1px;
                border-color: Theme.bg-deep;
            }

            chat-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    Snd.play(2);
                    root.chat-toggle();
                }
                Tooltip {
                    text: @markdown("\{T.chat_tip}");
                }
            }
        }

        WinBtn {
            y: (parent.height - 28px) / 2;
            kind: 0;
            tip: T.win_min;
            clicked => { root.win-min(); }
        }
        WinBtn {
            y: (parent.height - 28px) / 2;
            kind: root.is-maximized ? 2 : 1;
            tip: root.is-maximized ? T.win_restore : T.win_max;
            clicked => { root.win-max(); }
        }
        WinBtn {
            y: (parent.height - 28px) / 2;
            kind: 3;
            tip: T.win_close;
            clicked => { root.close-request(); }
        }
    }

    // По центру: плавающая капсула навигации (Dynamic Island)
    island := Rectangle {
        property <bool> island-hovered: island-bg-ta.has-hover
            || t0.hovered || t1.hovered || t2.hovered || t4.hovered
            || t5.hovered || t6.hovered || t7.hovered;
        property <length> pad: island.island-hovered ? 7px : 4px;
        animate pad { duration: 240ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }

        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        height: island.island-hovered ? 44px : 36px;
        width: t7.x + t7.width + island.pad;
        border-radius: self.height / 2;
        clip: true;
        background: Theme.surface;
        border-width: 1px;
        border-color: island.island-hovered ? #ffffff22 : Theme.border;
        animate height, border-color { duration: 240ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }

        island-bg-ta := TouchArea {
            width: 100%;
            height: 100%;
        }

        // Переезжающая активная пилюля
        pill := Rectangle {
            height: parent.height - 6px;
            y: 3px;
            border-radius: self.height / 2;
            background: Theme.surface-hover;
            border-width: 1px;
            border-color: #ffffff22;

            x: root.page == 0 ? t0.x
                : root.page == 1 ? t1.x
                : root.page == 2 ? t2.x
                : root.page == 4 ? t4.x
                : root.page == 5 ? t5.x
                : root.page == 6 ? t6.x
                : t7.x;

            width: root.page == 0 ? t0.width
                : root.page == 1 ? t1.width
                : root.page == 2 ? t2.width
                : root.page == 4 ? t4.width
                : root.page == 5 ? t5.width
                : root.page == 6 ? t6.width
                : t7.width;

            animate x, width { duration: 300ms; easing: cubic-bezier(0.34, 1.28, 0.64, 1); }
        }

        t0 := NavTab {
            x: island.pad;
            y: (island.height - self.height) / 2;
            kind: 0;
            label: T.nav_home;
            active: root.page == 0;
            clicked => { root.navigate(0); }
        }
        t1 := NavTab {
            x: t0.x + t0.width;
            y: (island.height - self.height) / 2;
            kind: 1;
            label: T.nav_games;
            active: root.page == 1;
            clicked => { root.navigate(1); }
        }
        t2 := NavTab {
            x: t1.x + t1.width;
            y: (island.height - self.height) / 2;
            kind: 2;
            label: T.nav_flags;
            active: root.page == 2;
            clicked => { root.navigate(2); }
        }
        t4 := NavTab {
            x: t2.x + t2.width;
            y: (island.height - self.height) / 2;
            kind: 4;
            label: T.nav_mods;
            active: root.page == 4;
            clicked => { root.navigate(4); }
        }
        t5 := NavTab {
            x: t4.x + t4.width;
            y: (island.height - self.height) / 2;
            kind: 5;
            label: T.nav_logs;
            shown: root.show-logs;
            active: root.page == 5;
            clicked => { root.navigate(5); }
        }
        t6 := NavTab {
            x: t5.x + t5.width;
            y: (island.height - self.height) / 2;
            kind: 6;
            label: T.nav_settings;
            active: root.page == 6;
            clicked => { root.navigate(6); }
        }
        t7 := NavTab {
            x: t6.x + t6.width;
            y: (island.height - self.height) / 2;
            kind: 7;
            label: T.nav_about;
            active: root.page == 7;
            clicked => { root.navigate(7); }
        }
    }
}
