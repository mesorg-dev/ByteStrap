// Корневое окно ByteStrap (Slint): frameless, звёздное небо под всем,
// кастомный titlebar + сайдбар, переключение страниц, анимированные модалки.
// Состояние и колбэки — из контроллера src/app_slint.rs.

import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-Bold.ttf";
import "../assets/fonts/JetBrainsMono-Regular.ttf";
import "../assets/fonts/JetBrainsMono-Bold.ttf";
import "../assets/fonts/Unbounded-Regular.ttf";
import "../assets/fonts/Unbounded-Bold.ttf";

import { Theme } from "theme.slint";
import { Snd } from "snd.slint";
import { T } from "i18n.slint";
export { T, Theme, Snd, ScreenshotRow }
import { TitleBar } from "titlebar.slint";
import { Btn, TextField, Dd } from "widgets.slint";
import { Starfield } from "stars.slint";
import { HomePage } from "pages/home.slint";
import { LogsPage } from "pages/logs.slint";
import { SettingsPage } from "pages/settings.slint";
import { ModsPage } from "pages/mods.slint";
import { FlagsPage } from "pages/flags.slint";
import { GamesPage } from "pages/games.slint";
import { AboutPage } from "pages/about.slint";
import { IconCross } from "icons.slint";
import { PlaceRow, GameRow, ServerRow, ScreenshotRow, LogLine, ModRow, ModFileRow, FlagRow, PresetRow, RegionPingRow } from "models.slint";

export component AppWindow inherits Window {
    title: "ByteStrap";
    no-frame: true;
    resize-border-width: 6px;
    min-width: 820px;
    min-height: 520px;
    preferred-width: 1120px;
    preferred-height: 700px;
    background: transparent;
    default-font-family: Theme.font;

    // ===== Состояние (заполняет контроллер) =====
    in-out property <int> page: 0;
    in-out property <bool> is-maximized: false;

    /// Пользовательский фон лаунчера.
    in-out property <image> bg-image;
    in-out property <bool> bg-image-on: false;
    // Splash-экран при запуске (окно скрыто/показано контроллером).
    in-out property <bool> splash-open: false;
    in-out property <image> splash-img;
    in-out property <bool> splash-img-on: false;

    in-out property <string> status-text: "";
    in-out property <int> status-dot: 0;
    in-out property <bool> busy: false;
    in-out property <bool> show-update: false;
    in-out property <string> primary-label;
    in-out property <float> progress: 0;
    in-out property <string> progress-text: "";
    in-out property <string> link-msg: "";
    in-out property <bool> link-msg-bad: false;
    in-out property <string> link-paste-text: "";
    in-out property <int> link-paste-token: 0;
    in-out property <string> version-text: "";
    in-out property <string> mods-count: "0";
    in-out property <string> flags-count: "0";
    in-out property <string> hours-count: "0";
    in-out property <string> session-text: "";
    in-out property <[PlaceRow]> top-places: [];
    /// Минуты по последним 14 дням (старые → новые) + подписи DD.MM.
    in-out property <[int]> play-days: [];
    in-out property <[string]> play-labels: [];
    in-out property <int> play-days-max: 60;

    // Games (page 1)
    in-out property <[GameRow]> games-rows: [];
    in-out property <string> games-msg: "";
    in-out property <bool> games-msg-err: false;
    in-out property <[ServerRow]> games-servers: [];
    in-out property <string> games-servers-msg: "";
    in-out property <bool> games-servers-busy: false;
    in-out property <bool> games-has-active-server: false;
    in-out property <string> games-active-server-region: "";
    in-out property <string> games-active-server-detail: "";
    in-out property <string> games-active-server-ping: "";
    in-out property <[RegionPingRow]> games-region-pings: [];
    in-out property <bool> games-ping-busy: false;
    in-out property <int> games-region-filter: 0;

    // Screenshots
    in-out property <[ScreenshotRow]> shots: [];
    in-out property <int> shot-selected: 0;
    in-out property <string> shot-preview-path: "";
    in-out property <string> shot-preview-name: "";
    in-out property <string> shot-preview-date: "";
    in-out property <string> shot-preview-size: "";
    in-out property <image> shot-preview-img;
    in-out property <string> shot-status: "";

    in-out property <[LogLine]> log-lines: [];
    in-out property <[string]> log-files: [];
    in-out property <int> log-selected: 0;
    in-out property <bool> log-follow: true;
    in-out property <string> log-info: "";
    in-out property <bool> log-missing: false;
    in-out property <int> log-jump-token: 0;

    // Mods (page 4)
    in-out property <string> mods-path: "";
    in-out property <[ModRow]> mods-list: [];
    in-out property <string> mods-msg: "";
    in-out property <bool> mods-msg-err: false;
    in-out property <bool> mods-apply-enabled: false;
    in-out property <bool> mods-revert-enabled: false;
    in-out property <string> mods-files-count: "";
    in-out property <[ModFileRow]> mods-files: [];
    in-out property <[string]> mods-profiles: [];
    in-out property <string> mods-profile-sel-text: "";
    in-out property <int> mods-profile-sel-index: -1;
    in-out property <bool> mods-profile-sel-valid: false;
    in-out property <bool> mods-profiles-empty: false;
    in-out property <int> mods-death-sound-mode: 0;
    in-out property <string> mods-death-sound-path: "";
    in-out property <int> mods-cursor-mode: 0;
    in-out property <int> mods-font-mode: 0;
    in-out property <string> mods-font-path: "";

    // Flags (page 2)
    in-out property <bool> flags-has-client: false;
    /// Windows-only возможности (импорт/буфер/экспорт, «Вставить» на Home).
    in-out property <bool> win-share: false;
    in-out property <[FlagRow]> flags-rows: [];
    in-out property <bool> flags-table-empty: false;
    in-out property <bool> flags-dirty: false;
    in-out property <string> flags-msg: "";
    in-out property <bool> flags-msg-err: false;
    in-out property <string> flags-sel-detail: "";
    in-out property <bool> flags-can-delete: false;
    in-out property <[PresetRow]> flags-presets: [];
    in-out property <string> flags-search: "";
    in-out property <[string]> flags-profiles: [];
    in-out property <string> flags-profile-sel-text: "";
    in-out property <int> flags-profile-sel-index: -1;
    in-out property <bool> flags-profile-sel-valid: false;
    in-out property <bool> flags-profiles-empty: false;
    /// Очередь конфликтов импорта (модальное окно).
    in-out property <bool> import-open: false;
    in-out property <string> import-body: "";

    // Вводной диалог («Сохранить как…» и не только)
    in-out property <bool> dlg-open: false;
    in-out property <string> dlg-desc: "";
    in-out property <string> dlg-hint: "";
    in-out property <string> dlg-input: "";
    in-out property <string> dlg-ok-label: "";

    // Settings (page 6)
    in-out property <int> set-ch-sel: -1;
    in-out property <bool> set-ch-checking: false;
    in-out property <int> set-ch-preview-kind: 0;
    in-out property <string> set-ch-preview-text: "";
    in-out property <bool> set-ch-changed: false;
    in-out property <int> set-lang-code: 0;
    in-out property <int> set-threads: 4;
    in-out property <bool> set-auto-update: true;
    in-out property <bool> set-close-launch: false;
    /// Сворачивать в трей вместо выхода (Windows).
    in-out property <bool> set-close-tray: true;
    in-out property <bool> set-auto-clean: false;
    /// Показывать вкладку «Логи» в сайдбаре.
    in-out property <bool> set-show-logs: true;
    /// Всплывающее уведомление о сервере и пинге при подключении.
    in-out property <bool> set-notify-server: true;
    in-out property <bool> set-discord-rp: true;
    in-out property <bool> set-rp-place: true;
    in-out property <bool> set-rp-time: true;
    in-out property <bool> set-rp-brand: true;
    in-out property <bool> set-rp-incognito: false;
    in-out property <bool> set-rp-server: true;
    in-out property <string> set-discord-custom: "";
    in-out property <int> set-discord-status: 0;
    in-out property <string> set-discord-text: "";
    in-out property <bool> set-deeplink: true;
    in-out property <bool> set-anti-afk: false;
    in-out property <int> set-deeplink-ok: 0;
    in-out property <string> set-path: "";
    in-out property <string> set-path-hint: "";
    in-out property <int> set-path-token: 0;
    in-out property <bool> set-cleanup-busy: false;
    in-out property <string> set-cleanup-text: "";
    in-out property <bool> set-cleanup-err: false;
    in-out property <string> set-cfg-msg: "";
    in-out property <bool> set-cfg-msg-err: false;
    in-out property <bool> set-sound: true;
    in-out property <int> set-sound-vol: 70;
    in-out property <bool> set-overlay-on: false;
    in-out property <int> set-overlay-bright: 0;
    in-out property <int> set-overlay-sat: 100;
    in-out property <int> set-overlay-contrast: 100;
    /// Оформление: индекс акцента, индекс фона, имя файла фона.
    in-out property <int> set-theme-accent: 0;
    in-out property <int> set-theme-bg: 0;
    in-out property <string> set-bg-image-name: "";
    in-out property <bool> set-splash-on: true;
    in-out property <string> set-splash-image-name: "";
    in-out property <bool> set-center-window: true;
    in-out property <bool> set-center-game: false;
    in-out property <int> set-pref-region: 0;
    in-out property <int> set-game-res-mode: 0;
    in-out property <string> set-game-res-w: "1920";
    in-out property <string> set-game-res-h: "1080";
    in-out property <bool> set-live-bg: true;

    // Кастомное разрешение для конкретной игры (Modal)
    in-out property <bool> game-res-modal-open: false;
    in-out property <string> game-res-modal-place: "";
    in-out property <string> game-res-modal-title: "";
    in-out property <int> game-res-modal-mode: 0;
    in-out property <string> game-res-modal-w: "1920";
    in-out property <string> game-res-modal-h: "1080";

    /// Тело модального подтверждения ("" — закрыто).
    in-out property <string> confirm-body: "";

    // About (page 7)
    in-out property <string> about-version: "";
    in-out property <int> update-kind: 0;
    in-out property <string> update-text: "";
    in-out property <string> update-notes: "";
    in-out property <float> update-pct: 0;

    // ===== Колбэки контроллеру =====
    callback close-request();
    callback link-changed();
    callback win-min();
    callback win-max();
    callback titlebar-drag();
    callback primary();
    callback studio();
    callback update-client();
    callback cancel-install();
    callback link-go(string);
    callback link-paste();
    callback games-add(string);
    callback games-launch(string);
    callback games-fav(string);
    callback games-remove(string);
    callback games-servers-refresh(string);
    callback games-servers-best(string);
    callback games-server-join(string, string);
    callback games-server-copy-id(string);
    callback games-region-filter-set(int);
    callback games-ping-test();
    callback shot-select(int);
    callback shot-copy(string);
    callback shot-open(string);
    callback shot-folder(string);
    callback shot-delete(string);
    callback shot-refresh();
    callback log-select(int);
    callback log-refresh();
    callback log-copy();
    callback log-folder();
    callback log-follow-toggle();
    callback log-search(string);
    callback about-check();
    callback about-download();
    callback about-open-repo();
    callback ch-pick(string);
    callback ch-apply();
    callback lang-pick(int);
    callback threads-set(int);
    callback auto-update-set(bool);
    callback close-launch-set(bool);
    callback close-tray-set(bool);
    callback auto-clean-set(bool);
    callback show-logs-set(bool);
    callback notify-server-set(bool);
    callback pref-region-set(int);
    callback cfg-export();
    callback cfg-import();
    callback discord-rp-set(bool);
    callback rp-opt-set(int, bool);
    callback rp-incognito-set(bool);
    callback rp-server-set(bool);
    callback discord-custom-set(string);
    callback deeplink-set(bool);
    callback anti-afk-set(bool);
    callback path-edited(string);
    callback path-reset();
    callback cleanup-run();
    callback sound-set(bool);
    callback sound-vol-set(int);
    callback overlay-set(bool);
    callback overlay-bright-set(int);
    callback overlay-sat-set(int);
    callback overlay-contrast-set(int);
    callback theme-accent-set(int);
    callback theme-bg-set(int);
    callback theme-bg-pick();
    callback theme-bg-reset();
    callback splash-set(bool);
    callback splash-pick();
    callback splash-reset();
    callback confirm-yes();
    callback confirm-no();
    callback mods-open-folder();
    callback mods-refresh();
    callback mods-apply();
    callback mods-revert();
    callback mods-death-sound-set(int);
    callback mods-death-sound-pick();
    callback mods-cursor-set(int);
    callback mods-font-set(int);
    callback mods-font-pick();
    callback mods-toggle-mod(string, bool);
    callback mods-move-mod(string, int);
    callback mods-open-mod-folder(string);
    callback mods-profile-pick(int);
    callback mods-profile-load();
    callback mods-profile-save-as();
    callback mods-profile-delete();
    callback mods-profile-export();
    callback mods-profile-import();
    callback dlg-edited(string);
    callback dlg-ok(string);
    callback dlg-cancel();
    callback game-res-modal-save(string, int, int, int);
    callback game-res-modal-close();
    callback center-window-set(bool);
    callback center-game-set(bool);
    callback game-res-mode-set(int);
    callback game-res-custom-set(int, int);
    callback live-bg-set(bool);
    callback flags-search-edited(string);
    callback flags-add();
    callback flags-save();
    callback flags-import();
    callback flags-paste();
    callback flags-export();
    callback flags-delete();
    callback flags-clear();
    callback flags-row-select(int);
    callback flags-cell-edited(int, int, string);
    callback preset-pick(int, int);
    callback preset-toggle(int, bool);
    callback flags-profile-pick(int);
    callback flags-profile-load();
    callback flags-profile-save-as();
    callback flags-profile-delete();
    callback flags-profile-export();
    callback flags-profile-import();
    /// 0 — оставить, 1 — заменить, 2 — заменить все, 3 — отмена.
    callback import-decision(int);

    // ===== Корневой контейнер с закруглёнными углами =====
    root-clip := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        border-radius: root.is-maximized ? 0px : 16px;
        clip: true;
        background: Theme.bg-deep;
        border-width: root.is-maximized ? 0px : 1px;
        border-color: Theme.border;

    // ===== Пользовательский фон (под звёздами) =====
    if root.bg-image-on : Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.bg-image;
        image-fit: cover;
        opacity: 0.6;
    }

    // ===== Звёздное небо под всем =====
    Starfield {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }

    // ===== Верхняя панель TitleBar =====
    TitleBar {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.titlebar-h;
        page: root.page;
        show-logs: root.set-show-logs;
        status-dot: root.status-dot;
        status: root.status-text;
        is-maximized: root.is-maximized;
        navigate(p) => { root.page = p; Dd.open = false; }
        win-min => { root.win-min(); }
        win-max => { root.win-max(); }
        drag => { root.titlebar-drag(); }
        close-request => { root.close-request(); }
    }

    // ===== Главная карточка контента =====
    Rectangle {
        x: 14px;
        y: Theme.titlebar-h;
        width: parent.width - 28px;
        height: parent.height - Theme.titlebar-h - 14px;
        background: Theme.surface;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        Rectangle {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            height: parent.height - 40px;

                if root.page == 0 : HomePage {
                    width: 100%;
                    height: 100%;
                    status-text: root.status-text;
                    status-dot: root.status-dot;
                    busy: root.busy;
                    show-update: root.show-update;
                    primary-label: root.primary-label;
                    progress: root.progress;
                    progress-text: root.progress-text;
                    link-msg: root.link-msg;
                    link-msg-bad: root.link-msg-bad;
                    paste-text: root.link-paste-text;
                    paste-token: root.link-paste-token;
                    version-text: root.version-text;
                    mods-count: root.mods-count;
                    flags-count: root.flags-count;
                    hours-count: root.hours-count;
                    session-text: root.session-text;
                    top-places: root.top-places;
                    play-days: root.play-days;
                    play-labels: root.play-labels;
                    play-days-max: root.play-days-max;
                    share: root.win-share;
                    primary => { root.primary(); }
                    studio => { root.studio(); }
                    update-client => { root.update-client(); }
                    cancel => { root.cancel-install(); }
                    link-go(url) => { root.link-go(url); }
                    link-changed => { root.link-changed(); }
                    link-paste => { root.link-paste(); }
                }

                if root.page == 1 : GamesPage {
                    width: 100%;
                    height: 100%;
                    rows: root.games-rows;
                    msg: root.games-msg;
                    msg-err: root.games-msg-err;
                    servers: root.games-servers;
                    servers-msg: root.games-servers-msg;
                    servers-busy: root.games-servers-busy;
                    region-filter: root.games-region-filter;
                    region-pings: root.games-region-pings;
                    ping-busy: root.games-ping-busy;
                    has-active-server: root.games-has-active-server;
                    active-server-region: root.games-active-server-region;
                    active-server-detail: root.games-active-server-detail;
                    active-server-ping: root.games-active-server-ping;
                    shots: root.shots;
                    shot-preview-path: root.shot-preview-path;
                    shot-preview-name: root.shot-preview-name;
                    shot-preview-date: root.shot-preview-date;
                    shot-preview-size: root.shot-preview-size;
                    shot-preview-img: root.shot-preview-img;
                    shot-status: root.shot-status;
                    add(t) => { root.games-add(t); }
                    launch(id) => { root.games-launch(id); }
                    fav(id) => { root.games-fav(id); }
                    remove(id) => { root.games-remove(id); }
                    servers-refresh(p) => { root.games-servers-refresh(p); }
                    servers-best(p) => { root.games-servers-best(p); }
                    server-join(p, j) => { root.games-server-join(p, j); }
                    server-copy-id(id) => { root.games-server-copy-id(id); }
                    region-filter-set(f) => { root.games-region-filter-set(f); }
                    ping-test => { root.games-ping-test(); }
                    shot-select(idx) => { root.shot-select(idx); }
                    shot-copy(p) => { root.shot-copy(p); }
                    shot-open(p) => { root.shot-open(p); }
                    shot-folder(p) => { root.shot-folder(p); }
                    shot-delete(p) => { root.shot-delete(p); }
                    shot-refresh => { root.shot-refresh(); }
                }

                if root.page == 5 : LogsPage {
                    width: 100%;
                    height: 100%;
                    lines: root.log-lines;
                    files: root.log-files;
                    selected: root.log-selected;
                    follow: root.log-follow;
                    info-text: root.log-info;
                    missing: root.log-missing;
                    jump-token: root.log-jump-token;
                    select-file(i) => { root.log-select(i); }
                    refresh => { root.log-refresh(); }
                    copy => { root.log-copy(); }
                    open-folder => { root.log-folder(); }
                    follow-toggle => { root.log-follow-toggle(); }
                    search-edited(q) => { root.log-search(q); }
                }

                if root.page == 2 : FlagsPage {
                    width: 100%;
                    height: 100%;
                    has-client: root.flags-has-client;
                    share: root.win-share;
                    rows: root.flags-rows;
                    table-empty: root.flags-table-empty;
                    dirty: root.flags-dirty;
                    msg: root.flags-msg;
                    msg-err: root.flags-msg-err;
                    sel-detail: root.flags-sel-detail;
                    can-delete: root.flags-can-delete;
                    presets: root.flags-presets;
                    search: root.flags-search;
                    profiles: root.flags-profiles;
                    profile-sel-text: root.flags-profile-sel-text;
                    profile-sel-index: root.flags-profile-sel-index;
                    profile-sel-valid: root.flags-profile-sel-valid;
                    profiles-empty: root.flags-profiles-empty;
                    search-edited(q) => { root.flags-search-edited(q); }
                    add => { root.flags-add(); }
                    save => { root.flags-save(); }
                    import-file => { root.flags-import(); }
                    paste => { root.flags-paste(); }
                    export-file => { root.flags-export(); }
                    delete-sel => { root.flags-delete(); }
                    clear-all => { root.flags-clear(); }
                    row-select(i) => { root.flags-row-select(i); }
                    cell-edited(idx, col, t) => { root.flags-cell-edited(idx, col, t); }
                    preset-pick(pi, oi) => { root.preset-pick(pi, oi); }
                    preset-toggle(pi, on) => { root.preset-toggle(pi, on); }
                    profile-pick(i) => { root.flags-profile-pick(i); }
                    profile-load => { root.flags-profile-load(); }
                    profile-save-as => { root.flags-profile-save-as(); }
                    profile-delete => { root.flags-profile-delete(); }
                    profile-export => { root.flags-profile-export(); }
                    profile-import => { root.flags-profile-import(); }
                }
                if root.page == 4 : ModsPage {
                    width: 100%;
                    height: 100%;
                    mods-path: root.mods-path;
                    mods-list: root.mods-list;
                    mods-msg: root.mods-msg;
                    mods-msg-err: root.mods-msg-err;
                    apply-enabled: root.mods-apply-enabled;
                    revert-enabled: root.mods-revert-enabled;
                    files-count: root.mods-files-count;
                    files: root.mods-files;
                    profiles: root.mods-profiles;
                    profile-sel-text: root.mods-profile-sel-text;
                    profile-sel-index: root.mods-profile-sel-index;
                    profile-sel-valid: root.mods-profile-sel-valid;
                    profiles-empty: root.mods-profiles-empty;
                    death-sound-mode: root.mods-death-sound-mode;
                    death-sound-path: root.mods-death-sound-path;
                    cursor-mode: root.mods-cursor-mode;
                    font-mode: root.mods-font-mode;
                    font-path: root.mods-font-path;
                    death-sound-set(m) => { root.mods-death-sound-set(m); }
                    death-sound-pick => { root.mods-death-sound-pick(); }
                    cursor-set(m) => { root.mods-cursor-set(m); }
                    font-set(m) => { root.mods-font-set(m); }
                    font-pick => { root.mods-font-pick(); }
                    open-folder => { root.mods-open-folder(); }
                    refresh => { root.mods-refresh(); }
                    apply => { root.mods-apply(); }
                    revert => { root.mods-revert(); }
                    toggle-mod(id, on) => { root.mods-toggle-mod(id, on); }
                    move-mod(id, d) => { root.mods-move-mod(id, d); }
                    open-mod-folder(id) => { root.mods-open-mod-folder(id); }
                    profile-pick(i) => { root.mods-profile-pick(i); }
                    profile-load => { root.mods-profile-load(); }
                    profile-save-as => { root.mods-profile-save-as(); }
                    profile-delete => { root.mods-profile-delete(); }
                    profile-export => { root.mods-profile-export(); }
                    profile-import => { root.mods-profile-import(); }
                }
                if root.page == 6 : SettingsPage {
                    width: 100%;
                    height: 100%;
                    busy: root.busy;
                    channel-sel: root.set-ch-sel;
                    channel-checking: root.set-ch-checking;
                    channel-preview-kind: root.set-ch-preview-kind;
                    channel-preview-text: root.set-ch-preview-text;
                    channel-changed: root.set-ch-changed;
                    lang-code: root.set-lang-code;
                    threads: root.set-threads;
                    auto-update: root.set-auto-update;
                    close-launch: root.set-close-launch;
                    close-tray: root.set-close-tray;
                    center-window: root.set-center-window;
                    center-game: root.set-center-game;
                    game-res-mode: root.set-game-res-mode;
                    game-res-w: root.set-game-res-w;
                    game-res-h: root.set-game-res-h;
                    live-bg: root.set-live-bg;
                    auto-clean: root.set-auto-clean;
                    show-logs: root.set-show-logs;
                    notify-server: root.set-notify-server;
                    pref-region: root.set-pref-region;
                    discord-rp: root.set-discord-rp;
                    rp-place: root.set-rp-place;
                    rp-time: root.set-rp-time;
                    rp-brand: root.set-rp-brand;
                    rp-incognito: root.set-rp-incognito;
                    rp-server: root.set-rp-server;
                    discord-custom: root.set-discord-custom;
                    discord-status: root.set-discord-status;
                    discord-text: root.set-discord-text;
                    deeplink: root.set-deeplink;
                    anti-afk: root.set-anti-afk;
                    deeplink-ok: root.set-deeplink-ok;
                    path: root.set-path;
                    path-hint: root.set-path-hint;
                    path-token: root.set-path-token;
                    cleanup-busy: root.set-cleanup-busy;
                    cleanup-text: root.set-cleanup-text;
                    cleanup-err: root.set-cleanup-err;
                    cfg-msg: root.set-cfg-msg;
                    cfg-msg-err: root.set-cfg-msg-err;
                    sound: root.set-sound;
                    sound-vol: root.set-sound-vol;
                    overlay-on: root.set-overlay-on;
                    overlay-bright: root.set-overlay-bright;
                    overlay-sat: root.set-overlay-sat;
                    overlay-contrast: root.set-overlay-contrast;
                    theme-accent: root.set-theme-accent;
                    theme-bg: root.set-theme-bg;
                    bg-image-name: root.set-bg-image-name;
                    splash-on: root.set-splash-on;
                    splash-image-name: root.set-splash-image-name;
                    channel-pick(c) => { root.ch-pick(c); }
                    channel-apply => { root.ch-apply(); }
                    lang-pick(i) => { root.lang-pick(i); }
                    threads-set(t) => { root.threads-set(t); }
                    auto-update-set(v) => { root.auto-update-set(v); }
                    close-launch-set(v) => { root.close-launch-set(v); }
                    close-tray-set(v) => { root.close-tray-set(v); }
                    center-window-set(v) => { root.center-window-set(v); }
                    center-game-set(v) => { root.center-game-set(v); }
                    game-res-mode-set(m) => { root.game-res-mode-set(m); }
                    game-res-custom-set(w, h) => { root.game-res-custom-set(w, h); }
                    live-bg-set(v) => { root.live-bg-set(v); }
                    auto-clean-set(v) => { root.auto-clean-set(v); }
                    show-logs-set(v) => { root.show-logs-set(v); }
                    notify-server-set(v) => { root.notify-server-set(v); }
                    pref-region-set(r) => { root.pref-region-set(r); }
                    cfg-export => { root.cfg-export(); }
                    cfg-import => { root.cfg-import(); }
                    discord-rp-set(v) => { root.discord-rp-set(v); }
                    rp-opt-set(k, v) => { root.rp-opt-set(k, v); }
                    rp-incognito-set(v) => { root.rp-incognito-set(v); }
                    rp-server-set(v) => { root.rp-server-set(v); }
                    discord-custom-set(s) => { root.discord-custom-set(s); }
                    deeplink-set(v) => { root.deeplink-set(v); }
                    anti-afk-set(v) => { root.anti-afk-set(v); }
                    path-edited(t) => { root.path-edited(t); }
                    path-reset => { root.path-reset(); }
                    cleanup-run => { root.cleanup-run(); }
                    sound-set(v) => { root.sound-set(v); }
                    sound-vol-set(v) => { root.sound-vol-set(v); }
                    overlay-set(v) => { root.overlay-set(v); }
                    overlay-bright-set(v) => { root.overlay-bright-set(v); }
                    overlay-sat-set(v) => { root.overlay-sat-set(v); }
                    overlay-contrast-set(v) => { root.overlay-contrast-set(v); }
                    theme-accent-set(i) => { root.theme-accent-set(i); }
                    theme-bg-set(i) => { root.theme-bg-set(i); }
                    theme-bg-pick => { root.theme-bg-pick(); }
                    theme-bg-reset => { root.theme-bg-reset(); }
                    splash-set(v) => { root.splash-set(v); }
                    splash-pick => { root.splash-pick(); }
                    splash-reset => { root.splash-reset(); }
                }
                if root.page == 7 : AboutPage {
                    width: 100%;
                    height: 100%;
                    app-version: root.about-version;
                    update-kind: root.update-kind;
                    update-text: root.update-text;
                    update-notes: root.update-notes;
                    update-pct: root.update-pct;
                    check-updates => { root.about-check(); }
                    download => { root.about-download(); }
                    open-repo => { root.about-open-repo(); }
                }
            }
        }

    // ===== Модальное подтверждение =====
    if root.confirm-body != "" : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #06070bcc;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.confirm-no(); }
        }

        modal-confirm := Rectangle {
            property <bool> shown: false;
            width: 400px;
            height: 144px;
            x: (parent.width - self.width) / 2;
            y: root.confirm-body != ""
                ? ((parent.height - self.height) / 2
                    + (modal-confirm.shown ? 0px : 14px))
                : 0px;
            animate y { duration: Theme.t-mid; easing: ease-out; }
            opacity: modal-confirm.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.t-mid; }
            init => { modal-confirm.shown = true; }

            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-hover;
            border-radius: 20px;
            clip: true;

            VerticalLayout {
                padding: 22px;
                spacing: 16px;

                Text {
                    text: root.confirm-body;
                    font-size: 13px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: T.btn_yes;
                        kind: 0;
                        width: 90px;
                        height: 34px;
                        clicked => { root.confirm-yes(); }
                    }
                    Rectangle { width: 8px; horizontal-stretch: 0; }
                    Btn {
                        label: T.btn_no;
                        kind: 2;
                        width: 90px;
                        height: 34px;
                        clicked => { root.confirm-no(); }
                    }
                }
            }
        }
    }

    // ===== Модальное окно кастомного разрешения плейса =====
    if root.game-res-modal-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #06070bcc;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.game-res-modal-close(); }
        }

        modal-res := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 310px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-hover;
            border-radius: 20px;
            clip: true;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    Text {
                        text: "Разрешение окна игры";
                        font-family: Theme.font-display;
                        font-weight: 700;
                        font-size: 16px;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.r-sm;
                        background: res-x-touch.has-hover ? #ffffff14 : transparent;
                        animate background { duration: Theme.t-fast; }

                        IconCross {
                            width: 10px;
                            height: 10px;
                            c: res-x-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        res-x-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.game-res-modal-close(); }
                        }
                    }
                }

                Text {
                    text: root.game-res-modal-title;
                    font-size: 12.5px;
                    color: Theme.accent;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        label: "По умолчанию";
                        kind: 2;
                        active: root.game-res-modal-mode == 0;
                        width: 120px;
                        height: 28px;
                        clicked => { root.game-res-modal-mode = 0; }
                    }
                    Btn {
                        label: "1920×1080";
                        kind: 2;
                        active: root.game-res-modal-mode == 1;
                        width: 110px;
                        height: 28px;
                        clicked => { root.game-res-modal-mode = 1; }
                    }
                    Btn {
                        label: "1440×1080 (4:3)";
                        kind: 2;
                        active: root.game-res-modal-mode == 3;
                        width: 140px;
                        height: 28px;
                        clicked => { root.game-res-modal-mode = 3; }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        label: "1280×720";
                        kind: 2;
                        active: root.game-res-modal-mode == 4;
                        width: 110px;
                        height: 28px;
                        clicked => { root.game-res-modal-mode = 4; }
                    }
                    Btn {
                        label: "1024×768 (4:3)";
                        kind: 2;
                        active: root.game-res-modal-mode == 5;
                        width: 130px;
                        height: 28px;
                        clicked => { root.game-res-modal-mode = 5; }
                    }
                    Btn {
                        label: "Своё W×H";
                        kind: 2;
                        active: root.game-res-modal-mode == 6;
                        width: 110px;
                        height: 28px;
                        clicked => { root.game-res-modal-mode = 6; }
                    }
                }

                if root.game-res-modal-mode == 6 : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Ширина:";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    m-res-w := TextField {
                        width: 80px;
                        height: 28px;
                        text: root.game-res-modal-w;
                        edited => { root.game-res-modal-w = self.text; }
                    }
                    Text {
                        text: "×";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Высота:";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    m-res-h := TextField {
                        width: 80px;
                        height: 28px;
                        text: root.game-res-modal-h;
                        edited => { root.game-res-modal-h = self.text; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Btn {
                        label: "Отмена";
                        kind: 2;
                        width: 90px;
                        height: 32px;
                        clicked => { root.game-res-modal-close(); }
                    }

                    Btn {
                        label: "Сохранить";
                        kind: 0;
                        width: 110px;
                        height: 32px;
                        clicked => {
                            root.game-res-modal-save(
                                root.game-res-modal-place,
                                root.game-res-modal-mode,
                                root.game-res-modal-w.to-float(),
                                root.game-res-modal-h.to-float()
                            );
                        }
                    }
                }
            }
        }
    }

    // ===== Вводной диалог =====
    if root.dlg-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #06070bcc;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.dlg-cancel(); }
        }

        modal-dlg := Rectangle {
            property <bool> shown: false;
            width: 420px;
            height: 172px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (modal-dlg.shown ? 0px : 14px);
            animate y { duration: Theme.t-mid; easing: ease-out; }
            opacity: modal-dlg.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.t-mid; }
            init => { modal-dlg.shown = true; }

            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-hover;
            border-radius: 20px;
            clip: true;

            VerticalLayout {
                padding: 22px;
                spacing: 10px;

                Text {
                    text: root.dlg-desc;
                    font-size: 13px;
                    height: 17px;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                dlg-field := TextField {
                    text: root.dlg-input;
                    placeholder: root.dlg-hint;
                    edited => { root.dlg-edited(dlg-field.text); }
                    accepted => { root.dlg-ok(dlg-field.text); }
                    init => {
                        dlg-field.focus-select-all();
                    }
                }

                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        label: T.btn_cancel;
                        kind: 2;
                        width: 100px;
                        height: 34px;
                        clicked => { root.dlg-cancel(); }
                    }
                    Rectangle { width: 8px; horizontal-stretch: 0; }
                    Btn {
                        label: root.dlg-ok-label;
                        kind: 0;
                        width: 120px;
                        height: 34px;
                        clicked => { root.dlg-ok(dlg-field.text); }
                    }
                }
            }
        }
    }

    // ===== Конфликт импорта (страница Flags) =====
    if root.import-open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #06070bcc;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.import-decision(3); }
        }

        modal-import := Rectangle {
            property <bool> shown: false;
            width: 480px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 40px + (modal-import.shown ? 0px : 14px);
            animate y { duration: Theme.t-mid; easing: ease-out; }
            opacity: modal-import.shown ? 1.0 : 0.0;
            animate opacity { duration: Theme.t-mid; }
            init => { modal-import.shown = true; }

            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-hover;
            border-radius: 20px;
            clip: true;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;

                Text {
                    text: T.flags_conflict_title;
                    font-weight: 600;
                    font-size: 13px;
                    height: 17px;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: root.import-body;
                    font-size: 13px;
                    height: 36px;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        label: T.flags_conflict_replace_all;
                        kind: 0;
                        width: 124px;
                        height: 34px;
                        clicked => { root.import-decision(2); }
                    }
                    Btn {
                        label: T.flags_conflict_replace;
                        kind: 0;
                        width: 106px;
                        height: 34px;
                        clicked => { root.import-decision(1); }
                    }
                    Btn {
                        label: T.flags_conflict_keep;
                        kind: 2;
                        width: 96px;
                        height: 34px;
                        clicked => { root.import-decision(0); }
                    }
                    Btn {
                        label: T.btn_cancel;
                        kind: 2;
                        width: 96px;
                        height: 34px;
                        clicked => { root.import-decision(3); }
                    }
                }
            }
        }
    }

    // ===== Оверлей дропдаунов (Combo) — поверх всего содержимого =====
    // Клик-вне закрывает список.
    if Dd.open : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { Dd.open = false; }
        }
    }
    // Список: у комбо, при нехватке места снизу — раскрывается вверх.
    if Dd.open : Rectangle {
        property <length> list-h: min(Dd.items.length * 28px + 10px, 214px);
        x: Dd.x - 1px;
        y: Dd.y + 4px + list-h > root.height - 8px
            ? max(8px, Dd.y - list-h - 4px - 36px)
            : Dd.y + 4px;
        width: Dd.w + 2px;
        height: list-h;

        property <bool> shown: false;
        opacity: shown ? 1.0 : 0.0;
        animate opacity { duration: Theme.t-fast; }
        init => { shown = true; }

        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-hover;
        border-radius: 12px;
        clip: true;

        for it[i] in Dd.items : Rectangle {
            x: 0;
            y: 5px + i * 28px;
            width: parent.width;
            height: 28px;
            background: i == Dd.selected ? Theme.surface-hover
                : row-touch.has-hover ? #ffffff0d
                : transparent;
            animate background { duration: Theme.t-fast; }

            Text {
                x: 11px;
                y: 0;
                width: parent.width - 22px;
                height: parent.height;
                text: it;
                font-size: 12px;
                color: i == Dd.selected ? Theme.text-primary : Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }

            row-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    Snd.play(2);
                    Dd.open = false;
                    if Dd.owner >= 0 && Dd.owner < 100 { root.preset-pick(Dd.owner, i); }
                    else if Dd.owner == 100 { root.flags-profile-pick(i); }
                    else if Dd.owner == 200 { root.mods-profile-pick(i); }
                    else if Dd.owner == 300 {
                        root.mods-death-sound-set(i);
                        if i == 4 { root.mods-death-sound-pick(); }
                    }
                    else if Dd.owner == 301 { root.mods-cursor-set(i); }
                    else if Dd.owner == 302 {
                        root.mods-font-set(i);
                        if i == 4 { root.mods-font-pick(); }
                    }
                    else if Dd.owner == 303 { root.pref-region-set(i); }
                }
            }
        }
    }

    // ===== Splash-экран (поверх всего, исчезает fade-out) =====
    Rectangle {
        property <float> op: root.splash-open ? 1.0 : 0.0;
        animate op { duration: 350ms; easing: ease-out; }

        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        visible: op > 0.01;
        opacity: op;
        background: Theme.bg-deep;

        Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: root.splash-img;
            image-fit: cover;
            visible: root.splash-img-on;
        }

        VerticalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            padding: 40px;
            alignment: center;

            Text {
                width: 100%;
                height: 64px;
                text: "ByteStrap";
                font-family: Theme.font-display;
                font-weight: 800;
                font-size: 44px;
                letter-spacing: 2px;
                color: Theme.text-primary;
                horizontal-alignment: center;
                visible: !root.splash-img-on;
            }
            Text {
                width: 100%;
                height: 20px;
                text: T.settings_splash_hint;
                font-size: 13px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                visible: !root.splash-img-on;
            }
        }
    }
    } // root-clip
}
