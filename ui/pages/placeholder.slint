// Заглушка для страниц, переносимых на Slint во второй фазе.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { IconHome, IconSliders, IconLayers, IconWrench, IconTerminal, IconGear, IconInfo } from "../icons.slint";

export component PlaceholderPage inherits Rectangle {
    /// Номер страницы — определяет иконку (как в сайдбаре).
    in-out property <int> icon: 0;
    in-out property <string> name;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            horizontal-stretch: 0;
            height: 56px;

            if root.icon == 0 : IconHome {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
            if root.icon == 1 : IconSliders {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
            if root.icon == 2 : IconLayers {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
            if root.icon == 3 : IconWrench {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
            if root.icon == 4 : IconTerminal {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
            if root.icon == 5 : IconGear {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
            if root.icon == 6 : IconInfo {
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px;
                height: 40px;
                c: Theme.fg-dimmer;
            }
        }

        Text {
            horizontal-stretch: 0;
            width: 100%;
            text: root.name;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: 18px;
            color: Theme.fg;
            horizontal-alignment: center;
        }

        Text {
            horizontal-stretch: 0;
            width: 100%;
            text: T.common_soon;
            font-family: Theme.font-mono;
            font-size: 12px;
            color: Theme.fg-dimmer;
            horizontal-alignment: center;
        }
    }
}
