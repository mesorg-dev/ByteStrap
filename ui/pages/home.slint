// Главная: hero-карточка (играть/установить/обновить, прогресс, ссылка),
// счётчики и топ мест по времени. Данные приходят свойствами из контроллера.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { PageFade, Btn, TextField, ProgressBar, StatusDot, Combo } from "../widgets.slint";
import { PlaceRow, FriendRow, AccountGameRow } from "../models.slint";
import { IconPlus, IconCross, IconQr, IconUsers, IconGamepad, IconMonitor, IconRefresh } from "../icons.slint";

export component HomePage inherits PageFade {
    in-out property <[FriendRow]> friends: [];
    in-out property <[AccountGameRow]> recent-games: [];
    in-out property <bool> friends-busy: false;
    callback friend-join(string, string);
    callback friends-refresh();
    callback recent-game-play(string);
    callback game-res-edit(string, string);
    in-out property <string> status-text;
    in-out property <int> status-dot: 0;
    in-out property <bool> busy: false;
    in-out property <bool> show-update: false;
    in-out property <string> primary-label;
    in-out property <float> progress: 0;
    in-out property <string> progress-text;
    in-out property <string> link-msg;
    in-out property <bool> link-msg-bad: false;
    /// Текст из буфера обмена (пушит контроллер) + токен вставки.
    in-out property <string> paste-text;
    in-out property <int> paste-token: 0;

    changed paste-token => {
        link-input.text = root.paste-text;
    }
    in-out property <string> version-text;
    in-out property <string> mods-count;
    in-out property <string> flags-count;
    in-out property <string> hours-count;
    in-out property <[PlaceRow]> top-places;
    /// Минуты игры за последние 14 дней (старые → новые) и подписи DD.MM.
    in-out property <[int]> play-days: [];
    in-out property <[string]> play-labels: [];
    in-out property <int> play-days-max: 60;
    /// Строка живой сессии («в игре … · место …»), "" — скрыто.
    in-out property <string> session-text;
    /// Аккаунты: список, выбранный индекс и имя активного.
    in-out property <[string]> account-items: [];
    in-out property <int> account-sel: 0;
    in-out property <string> account-name: "";
    in-out property <string> account-initial: "○";
    /// Windows-only кнопка «Вставить».
    in-out property <bool> share: true;

    callback primary();
    callback update-client();
    callback cancel();
    callback link-go(string);
    callback link-paste();
    callback link-changed();
    callback account-pick(int);
    callback quick-login();

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: flick.width;
        content-height: col.preferred-height;

        col := VerticalLayout {
            width: flick.width;
            height: flick.content-height;
            spacing: 0px;

            Text {
                text: T.home_h1;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: 22px;
                letter-spacing: 0.5px;
                color: Theme.fg;
            }
            Rectangle { height: 5px; }
            Text {
                text: T.home_sub;
                font-size: 12.5px;
                color: Theme.fg-dim;
            }
            Rectangle { height: 16px; }

            // ===== Hero-карточка статуса =====
            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000066;
                drop-shadow-offset-y: 4px;

                // Верхняя световая кромка (стекло).
                Rectangle {
                    x: 12px;
                    y: 0;
                    width: parent.width - 24px;
                    height: 1px;
                    background: #ffffff1c;
                }

                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;

                    // Аккаунт: стильный блок профиля с аватаром, статусом и быстрыми действиями
                    Rectangle {
                        height: 52px;
                        border-radius: Theme.r-soft;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: #ffffff1f;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;

                            // Аватар профиля (по центру вертикали)
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 17px;
                                    background: root.account-sel > 0 ? #6ea8fe26 : #ffffff14;
                                    border-width: 1px;
                                    border-color: root.account-sel > 0 ? #6ea8fe66 : #ffffff26;

                                    Text {
                                        text: root.account-initial;
                                        font-family: Theme.font-display;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: root.account-sel > 0 ? #6ea8fe : Theme.fg-dim;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Никнейм и статус (слева, растягивается)
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: root.account-name != "" ? root.account-name : T.home_account;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.fg;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    if root.account-sel > 0 : Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: #7ee2b8;
                                        y: 5px;
                                    }
                                }

                                Text {
                                    text: root.account-sel > 0 ? T.home_account_active : T.home_account_guest;
                                    font-size: 11px;
                                    color: Theme.fg-dim;
                                    overflow: elide;
                                }
                            }

                            // Правая часть: кнопки (прижаты к правому краю, НЕ растягиваются)
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 8px;

                                    // Кнопка Quick Sign-In с вектором IconQr
                                    Rectangle {
                                        height: 32px;
                                        border-radius: Theme.r-soft;
                                        background: q-touch.has-hover ? #ffffff24 : #ffffff14;
                                        border-width: 1px;
                                        border-color: #ffffff29;
                                        animate background { duration: Theme.t-fast; }

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                IconQr {
                                                    width: 14px;
                                                    height: 14px;
                                                    c: Theme.fg;
                                                }
                                            }

                                            Text {
                                                text: T.home_account_quick;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: Theme.fg;
                                                vertical-alignment: center;
                                            }
                                        }

                                        q-touch := TouchArea {
                                            clicked => {
                                                root.quick-login();
                                            }
                                        }
                                    }

                                    // Выпадающий список выбора аккаунта
                                    account-combo := Combo {
                                        dd-id: 300;
                                        width: 135px;
                                        height: 32px;
                                        items: root.account-items;
                                        selected: root.account-sel;
                                        current-text: root.account-sel > 0 ? T.home_account_change : T.home_account_select;
                                    }

                                    // Кнопка добавления по куке (SVG +)
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: Theme.r-soft;
                                        background: add-touch.has-hover ? #ffffff24 : #ffffff14;
                                        border-width: 1px;
                                        border-color: #ffffff29;
                                        animate background { duration: Theme.t-fast; }

                                        IconPlus {
                                            width: 14px;
                                            height: 14px;
                                            c: Theme.fg;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        add-touch := TouchArea {
                                            clicked => {
                                                root.account-pick(root.account-items.length - (root.account-sel > 0 ? 2 : 1));
                                            }
                                        }
                                    }

                                    // Кнопка быстрого удаления активного аккаунта (SVG ✕)
                                    if root.account-sel > 0 : Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: Theme.r-soft;
                                        background: del-touch.has-hover ? #ff4d6d33 : #ffffff14;
                                        border-width: 1px;
                                        border-color: del-touch.has-hover ? #ff4d6d66 : #ffffff29;
                                        animate background { duration: Theme.t-fast; }

                                        IconCross {
                                            width: 12px;
                                            height: 12px;
                                            c: del-touch.has-hover ? #ff6b8b : Theme.fg-dim;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        del-touch := TouchArea {
                                            clicked => {
                                                root.account-pick(root.account-items.length - 1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Строка: точка + статус + кнопки справа.
                    Rectangle {
                        height: 48px;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 10px;

                            StatusDot {
                                kind: root.status-dot;
                                horizontal-stretch: 0;
                            }

                            Text {
                                text: root.status-text;
                                font-family: Theme.font;
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.fg;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            if root.busy : Btn {
                                label: T.btn_cancel;
                                kind: 2;
                                width: 110px;
                                height: 34px;
                                horizontal-stretch: 0;
                                clicked => { root.cancel(); }
                            }

                            if !root.busy && root.show-update : Btn {
                                label: T.home_update;
                                kind: 1;
                                width: 130px;
                                height: 40px;
                                horizontal-stretch: 0;
                                clicked => { root.update-client(); }
                            }

                            if !root.busy && root.show-update : Btn {
                                label: T.home_play;
                                kind: 0;
                                width: 150px;
                                height: 48px;
                                horizontal-stretch: 0;
                                clicked => { root.primary(); }
                            }

                            if !root.busy && !root.show-update : Btn {
                                label: root.primary-label;
                                kind: 0;
                                width: 220px;
                                height: 48px;
                                horizontal-stretch: 0;
                                clicked => { root.primary(); }
                            }
                        }
                    }

                    // Прогресс установки.
                    if root.busy : Rectangle {
                        height: root.progress-text == "" ? 4px : 24px;
                        VerticalLayout {
                            spacing: 7px;
                            ProgressBar {
                                value: root.progress;
                            }
                            if root.progress-text != "" : Text {
                                text: root.progress-text;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                color: Theme.fg-dim;
                            }
                        }
                    }

                    // Строка «запуск по ссылке».
                    Rectangle {
                        height: 28px;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 8px;

                            link-input := TextField {
                                height: 28px;
                                placeholder: T.home_link_hint;
                                horizontal-stretch: 1;
                                accepted => { root.link-go(self.text); }
                                edited => { root.link-changed(); }
                            }

                            if root.share : Btn {
                                label: T.home_link_paste;
                                kind: 2;
                                width: 78px;
                                height: 28px;
                                horizontal-stretch: 0;
                                clicked => { root.link-paste(); }
                            }

                            Btn {
                                label: T.home_link_go;
                                kind: 1;
                                width: 88px;
                                height: 28px;
                                horizontal-stretch: 0;
                                clicked => { root.link-go(link-input.text); }
                            }
                        }
                    }

                    if root.link-msg != "" : Text {
                        text: root.link-msg;
                        font-size: 11px;
                        color: root.link-msg-bad ? Theme.bad : Theme.good;
                    }

                    Rectangle {
                        height: 1px;
                        background: #ffffff0d;
                    }

                    Text {
                        text: root.version-text;
                        font-family: Theme.font-mono;
                        font-size: 11.5px;
                        color: Theme.fg-dimmer;
                    }
                }
            }

            Rectangle { height: 14px; }

            // ===== Друзья в сети =====
            if root.account-sel > 0 : Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    // Заголовок
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            IconUsers {
                                width: 14px;
                                height: 14px;
                                c: Theme.fg-dim;
                            }
                        }

                        Text {
                            text: T.home_friends_title + " (" + root.friends.length + ")";
                            font-family: Theme.font-mono;
                            font-size: 10px;
                            letter-spacing: 2px;
                            color: Theme.fg-dimmer;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        // Кнопка обновить
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: Theme.r-soft;
                            background: f-ref-touch.has-hover ? #ffffff24 : #ffffff10;
                            border-width: 1px;
                            border-color: #ffffff20;
                            animate background { duration: Theme.t-fast; }

                            IconRefresh {
                                width: 12px;
                                height: 12px;
                                c: Theme.fg;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            f-ref-touch := TouchArea {
                                clicked => { root.friends-refresh(); }
                            }
                        }
                    }

                    if root.friends.length == 0 : Text {
                        text: root.friends-busy ? "Загрузка списка друзей..." : T.home_friends_empty;
                        font-size: 12px;
                        color: Theme.fg-dim;
                    }

                    for f in root.friends : Rectangle {
                        height: 44px;
                        border-radius: Theme.r-soft;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: #ffffff14;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            // Аватар друга
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: f.is-ingame ? #7ee2b826 : #6ea8fe26;
                                    border-width: 1px;
                                    border-color: f.is-ingame ? #7ee2b866 : #6ea8fe66;

                                    Text {
                                        text: f.initial;
                                        font-family: Theme.font-display;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: f.is-ingame ? #7ee2b8 : #6ea8fe;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Имя и статус
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: f.display-name != "" ? f.display-name : f.name;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: Theme.fg;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    if f.name != "" && f.name != f.display-name : Text {
                                        text: "@" + f.name;
                                        font-size: 10.5px;
                                        color: Theme.fg-dimmer;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;

                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: f.is-ingame ? #7ee2b8 : #6ea8fe;
                                        y: 4px;
                                    }

                                    Text {
                                        text: f.status-text;
                                        font-size: 11px;
                                        color: f.is-ingame ? #7ee2b8 : Theme.fg-dim;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Кнопка зайти к другу на сервер
                            if f.is-ingame && f.place-id != "0" && f.place-id != "" : VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                Btn {
                                    label: T.home_friends_join;
                                    kind: 0;
                                    width: 90px;
                                    height: 28px;
                                    clicked => {
                                        root.friend-join(f.place-id, f.game-id);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.account-sel > 0 : Rectangle { height: 14px; }

            // ===== Игры аккаунта =====
            if root.account-sel > 0 && root.recent-games.length > 0 : Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            IconGamepad {
                                width: 14px;
                                height: 14px;
                                c: Theme.fg-dim;
                            }
                        }

                        Text {
                            text: T.home_recent_title;
                            font-family: Theme.font-mono;
                            font-size: 10px;
                            letter-spacing: 2px;
                            color: Theme.fg-dimmer;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }

                    for g in root.recent-games : Rectangle {
                        height: 38px;
                        border-radius: Theme.r-soft;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: #ffffff10;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 10px;

                            Text {
                                text: g.name;
                                font-size: 12.5px;
                                font-weight: 500;
                                color: Theme.fg;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            // Бейдж кастомного разрешения
                            Rectangle {
                                height: 24px;
                                border-radius: Theme.r-soft;
                                background: res-touch.has-hover ? #ffffff20 : #ffffff10;
                                border-width: 1px;
                                border-color: #ffffff1a;
                                animate background { duration: Theme.t-fast; }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 5px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        IconMonitor {
                                            width: 12px;
                                            height: 12px;
                                            c: Theme.fg-dim;
                                        }
                                    }

                                    Text {
                                        text: g.custom-res != "" ? g.custom-res : T.settings_res_auto;
                                        font-family: Theme.font-mono;
                                        font-size: 10.5px;
                                        color: Theme.fg-dim;
                                        vertical-alignment: center;
                                    }
                                }

                                res-touch := TouchArea {
                                    clicked => {
                                        root.game-res-edit(g.place-id, g.name);
                                    }
                                }
                            }

                            // Кнопка играть
                            Btn {
                                label: T.home_play;
                                kind: 1;
                                width: 75px;
                                height: 26px;
                                clicked => {
                                    root.recent-game-play(g.place-id);
                                }
                            }
                        }
                    }
                }
            }

            if root.account-sel > 0 && root.recent-games.length > 0 : Rectangle { height: 14px; }

            // ===== Счётчики =====
            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 22px;
                    spacing: 0px;

                    if root.session-text != "" : Text {
                        text: root.session-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: Theme.good;
                    }
                    if root.session-text != "" : Rectangle {
                        height: 14px;
                    }

                    HorizontalLayout {
                        spacing: 0px;
                        alignment: start;

                        VerticalLayout {
                            width: 140px;
                            horizontal-stretch: 0;
                            spacing: 2px;
                            Text {
                                text: root.mods-count;
                                font-family: Theme.font-display;
                                font-weight: 700;
                                font-size: 26px;
                                color: Theme.fg;
                            }
                            Text {
                                text: "MODS";
                                font-family: Theme.font-mono;
                                font-size: 10px;
                                letter-spacing: 2px;
                                color: Theme.fg-dimmer;
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 46px;
                            background: #ffffff0d;
                        }

                        VerticalLayout {
                            width: 168px;
                            padding-left: 28px;
                            horizontal-stretch: 0;
                            spacing: 2px;
                            Text {
                                text: root.flags-count;
                                font-family: Theme.font-display;
                                font-weight: 700;
                                font-size: 26px;
                                color: Theme.fg;
                            }
                            Text {
                                text: "FLAGS";
                                font-family: Theme.font-mono;
                                font-size: 10px;
                                letter-spacing: 2px;
                                color: Theme.fg-dimmer;
                            }
                        }

                        Rectangle {
                            width: 1px;
                            height: 46px;
                            background: #ffffff0d;
                        }

                        VerticalLayout {
                            padding-left: 28px;
                            horizontal-stretch: 0;
                            spacing: 2px;
                            Text {
                                text: root.hours-count;
                                font-family: Theme.font-display;
                                font-weight: 700;
                                font-size: 26px;
                                color: Theme.fg;
                            }
                            Text {
                                text: "HOURS";
                                font-family: Theme.font-mono;
                                font-size: 10px;
                                letter-spacing: 2px;
                                color: Theme.fg-dimmer;
                            }
                        }
                    }
                }
            }

            // ===== Активность за 14 дней =====
            if root.play-days.length > 0 : Rectangle {
                clip: true;
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 22px;
                    spacing: 10px;

                    Text {
                        text: T.home_chart;
                        font-family: Theme.font-mono;
                        font-size: 10px;
                        letter-spacing: 2px;
                        color: Theme.fg-dimmer;
                    }

                    // 14 колонок: чем выше — тем больше минут; столбик тянется вверх.
                    Rectangle {
                        height: 56px;
                        clip: true;

                        bars := HorizontalLayout {
                            spacing: 5px;

                            property <int> max-val: max(60, root.play-days-max);
                            for i in 14 : Rectangle {
                                clip: true;
                                property <length> h: min(52px, max(0px, 52px * (root.play-days[i] / (bars.max-val * 1.0))));
                                width: (parent.width - 65px) / 14;
                                height: 56px;

                                // «Пол» — всегда виден.
                                Rectangle {
                                    x: 0;
                                    y: 54px;
                                    width: parent.width;
                                    height: 2px;
                                    border-radius: 1px;
                                    background: #ffffff0d;
                                }

                                Rectangle {
                                    x: 0;
                                    y: parent.height - parent.h - 2px;
                                    width: parent.width;
                                    height: parent.h;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                    opacity: bar-touch.has-hover ? 1.0 : (0.55 + 0.45 * (parent.h / 52px));
                                    drop-shadow-blur: bar-touch.has-hover ? 8px : 0px;
                                    drop-shadow-color: Theme.glow;
                                    animate height { duration: Theme.t-mid; easing: ease-out; }
                                    animate opacity { duration: Theme.t-fast; }
                                }

                                bar-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    Tooltip {
                                        text: @markdown("\{root.play-labels[i]} · \{root.play-days[i]} мин");
                                    }
                                }
                            }
                        }
                    }

                    // Подписи: первый и последний день.
                    HorizontalLayout {
                        height: 12px;
                        Text {
                            font-family: Theme.font-mono;
                            font-size: 9px;
                            color: Theme.fg-dimmer;
                            text: root.play-labels[0];
                            horizontal-stretch: 1;
                        }
                        Text {
                            font-family: Theme.font-mono;
                            font-size: 9px;
                            color: Theme.fg-dimmer;
                            text: root.play-labels[13];
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle { height: 12px; }
                }
            }

            // ===== Топ мест =====
            if root.top-places.length > 0 : Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 22px;
                    spacing: 10px;

                    Text {
                        text: T.home_places;
                        font-family: Theme.font-mono;
                        font-size: 10px;
                        letter-spacing: 2px;
                        color: Theme.fg-dimmer;
                    }

                    for place in root.top-places : Rectangle {
                        height: 22px;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 8px;

                            Text {
                                text: place.name;
                                font-size: 13px;
                                color: Theme.fg;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: place.duration;
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                color: Theme.fg-dim;
                                horizontal-stretch: 0;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
