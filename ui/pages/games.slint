// Страница «Игры»: управление сохранёнными плейсами,
// продвинутый браузер серверов с пингом и регионами,
// встроенная галерея скриншотов Roblox.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Snd } from "../snd.slint";
import { PageFade, Btn, TextField, StatusDot } from "../widgets.slint";
import { GameRow, ServerRow, ScreenshotRow, RegionPingRow, PlaceRow } from "../models.slint";
import { IconGamepad, IconCamera, IconCross, IconStar } from "../icons.slint";

export component GamesPage inherits PageFade {
    /// 0 — Игры и Серверы, 1 — Галерея скриншотов.
    in-out property <int> active-tab: 0;

    in-out property <[GameRow]> rows;
    in-out property <[PlaceRow]> top-places: [];
    in-out property <string> msg;
    in-out property <bool> msg-err: false;

    /// Сервера выбранного места.
    in-out property <[ServerRow]> servers: [];
    in-out property <string> servers-msg: "";
    in-out property <bool> servers-busy: false;
    in-out property <int> region-filter: 0;

    /// Тест пинга до дата-центров Roblox.
    in-out property <[RegionPingRow]> region-pings: [];
    in-out property <bool> ping-busy: false;

    /// Активный сервер во время игры.
    in-out property <bool> has-active-server: false;
    in-out property <string> active-server-region: "";
    in-out property <string> active-server-detail: "";
    in-out property <string> active-server-ping: "";

    /// Галерея скриншотов.
    in-out property <[ScreenshotRow]> shots: [];
    in-out property <int> shot-selected: -1;
    in-out property <string> shot-preview-path: "";
    in-out property <string> shot-preview-name: "";
    in-out property <string> shot-preview-date: "";
    in-out property <string> shot-preview-size: "";
    in-out property <image> shot-preview-img;
    in-out property <string> shot-status: "";

    callback add(string);
    callback launch(string);
    callback fav(string);
    callback remove(string);
    callback servers-refresh(string);
    callback servers-best(string);
    callback server-join(string, string);
    callback server-copy-id(string);
    callback region-filter-set(int);
    callback ping-test();

    callback shot-select(int);
    callback shot-copy(string);
    callback shot-open(string);
    callback shot-folder(string);
    callback shot-delete(string);
    callback shot-refresh();

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 12px;

        // 1. ВЕРХНЯЯ ПАНЕЛЬ ПОДВКЛАДОК
        HorizontalLayout {
            height: 38px;
            spacing: 12px;

            // Капсула-переключатель подвкладок
            Rectangle {
                horizontal-stretch: 0;
                height: 36px;
                y: (parent.height - 36px) / 2;
                border-radius: 18px;
                background: #12141C;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                width: games-tab-row.preferred-width + 6px;

                // Скользящая активная пилюля
                games-pill := Rectangle {
                    height: 30px;
                    y: 3px;
                    border-radius: 15px;
                    background: Theme.surface-hover;
                    border-width: 1px;
                    border-color: #ffffff22;

                    x: games-tab-row.x + (root.active-tab == 0 ? stab0.x : stab1.x);
                    width: root.active-tab == 0 ? stab0.width : stab1.width;
                    animate x, width { duration: 240ms; easing: cubic-bezier(0.34, 1.25, 0.64, 1); }
                }

                games-tab-row := HorizontalLayout {
                    x: 3px;
                    y: 3px;
                    height: 30px;
                    padding: 0px;
                    spacing: 4px;

                    // Подвкладка 0: Игры и серверы
                    stab0 := Rectangle {
                        height: 30px;
                        border-radius: 15px;
                        background: (tab0-touch.has-hover && root.active-tab != 0) ? #ffffff0d : transparent;
                        animate background { duration: Theme.t-fast; }

                        HorizontalLayout {
                            height: 100%;
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;

                                IconGamepad {
                                    width: 16px;
                                    height: 16px;
                                    property <color> icon-c: root.active-tab == 0 ? Theme.accent : (tab0-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                    animate icon-c { duration: 180ms; }
                                    c: self.icon-c;
                                }
                            }

                            Text {
                                text: T.games_tab_places;
                                font-size: 12px;
                                font-weight: root.active-tab == 0 ? 600 : 400;
                                color: root.active-tab == 0 ? Theme.text-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        tab0-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                Snd.play(2);
                                root.active-tab = 0;
                            }
                        }
                    }

                    // Подвкладка 1: Скриншоты
                    stab1 := Rectangle {
                        height: 30px;
                        border-radius: 15px;
                        background: (tab1-touch.has-hover && root.active-tab != 1) ? #ffffff0d : transparent;
                        animate background { duration: Theme.t-fast; }

                        HorizontalLayout {
                            height: 100%;
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;

                            VerticalLayout {
                                alignment: center;

                                IconCamera {
                                    width: 16px;
                                    height: 16px;
                                    property <color> icon-c: root.active-tab == 1 ? Theme.accent : (tab1-touch.has-hover ? Theme.text-primary : Theme.text-secondary);
                                    animate icon-c { duration: 180ms; }
                                    c: self.icon-c;
                                }
                            }

                            Text {
                                text: T.games_tab_shots;
                                font-size: 12px;
                                font-weight: root.active-tab == 1 ? 600 : 400;
                                color: root.active-tab == 1 ? Theme.text-primary : Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        tab1-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                Snd.play(2);
                                root.active-tab = 1;
                                root.shot-refresh();
                            }
                        }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Справа: статус активного сервера Roblox
            if root.active-tab == 0 && root.has-active-server : Rectangle {
                height: 32px;
                y: (parent.height - 32px) / 2;
                border-radius: 16px;
                background: #12141C;
                border-width: 1px;
                border-color: Theme.border-accent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    StatusDot {
                        y: (parent.height - 8px) / 2;
                        kind: 1;
                    }

                    Text {
                        text: root.active-server-region + (root.active-server-detail != "" ? (" · " + root.active-server-detail) : "");
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    if root.active-server-ping != "" : Text {
                        text: root.active-server-ping;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. ПОДВКЛАДКА 0: ИГРЫ И СЕРВЕРЫ
        if root.active-tab == 0 : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            // Блок «ЛУЧШИЕ ПЛЕЙСЫ» (если есть плейсы в статистике)
            if root.top-places.length > 0 : VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    height: 18px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "ЛУЧШИЕ ПЛЕЙСЫ";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 10px;

                    for place[idx] in root.top-places : top-card := Rectangle {
                        horizontal-stretch: 1;
                        height: 72px;
                        border-radius: 14px;
                        background: #12141C;
                        border-width: 1px;
                        border-color: top-card-touch.has-hover ? Theme.border-hover : Theme.border;
                        animate border-color { duration: Theme.t-fast; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            alignment: center;

                            // Квадратная скруглённая аватарка 52x52px
                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 12px;
                                clip: true;
                                background: Theme.surface-2;

                                if place.has-icon : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: place.icon;
                                    image-fit: cover;
                                }

                                if !place.has-icon : Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: #1e2230;

                                    IconGamepad {
                                        width: 22px;
                                        height: 22px;
                                        c: Theme.accent;
                                        x: (parent.width - 22px) / 2;
                                        y: (parent.height - 22px) / 2;
                                    }
                                }
                            }

                            // Название и время игры
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: place.name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }

                                Text {
                                    text: place.duration;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }

                            // Кнопка быстрого входа
                            Btn {
                                label: "Зайти";
                                kind: 1;
                                height: 30px;
                                min-width: 78px;
                                horizontal-stretch: 0;
                                pad-x: 12px;
                                clicked => {
                                    Snd.play(0);
                                    root.launch(place.id);
                                }
                            }
                        }

                        top-card-touch := TouchArea {
                            width: parent.width - 96px;
                            height: 100%;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                Snd.play(2);
                                root.servers-refresh(place.id);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;

                // ЛЕВАЯ КОЛОНКА: сохранённые игры
            Rectangle {
                horizontal-stretch: 5;
                background: #12141C;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Строка добавления игры
                    HorizontalLayout {
                        spacing: 8px;

                        add-field := TextField {
                            height: 36px;
                            placeholder: T.games_hint;
                            horizontal-stretch: 1;
                            accepted => {
                                if self.text != "" {
                                    root.add(self.text);
                                    self.text = "";
                                }
                            }
                        }

                        Btn {
                            label: T.games_add;
                            kind: 0;
                            height: 36px;
                            clicked => {
                                if add-field.text != "" {
                                    root.add(add-field.text);
                                    add-field.text = "";
                                }
                            }
                        }
                    }

                    // Сообщение валидации/ошибки
                    if root.msg != "" : Text {
                        text: root.msg;
                        font-size: 12px;
                        color: root.msg-err ? Theme.danger : Theme.text-secondary;
                        overflow: elide;
                    }

                    // Список сохранённых игр
                    if root.rows.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: T.games_empty;
                            font-size: 12px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.rows.length > 0 : Flickable {
                        vertical-stretch: 1;
                        content-width: self.width;
                        content-height: games-col.preferred-height;

                        games-col := VerticalLayout {
                            y: 0px;
                            width: parent.width;
                            height: self.preferred-height;
                            alignment: start;
                            spacing: 6px;

                            for game in root.rows : Rectangle {
                                height: 50px;
                                border-radius: 12px;
                                background: #161822;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 10px;

                                    // Кнопка избранного
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        vertical-stretch: 0;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: fav-touch.has-hover ? #ffffff0d : transparent;

                                        IconStar {
                                            width: 14px;
                                            height: 14px;
                                            c: game.fav ? Theme.warning : Theme.text-muted;
                                            x: (parent.width - 14px) / 2;
                                            y: (parent.height - 14px) / 2;
                                        }

                                        fav-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                Snd.play(2);
                                                root.fav(game.id);
                                            }
                                        }
                                    }

                                    // Название и метаданные
                                    Rectangle {
                                        horizontal-stretch: 1;

                                        VerticalLayout {
                                            width: 100%;
                                            height: 100%;
                                            alignment: center;
                                            spacing: 2px;

                                            Text {
                                                text: game.name;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.text-primary;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: (game.bad ? game.id : ("place " + game.id)) + " · " + game.visits + " зап. · " + game.last;
                                                font-family: Theme.font-mono;
                                                font-size: 11px;
                                                color: Theme.text-secondary;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }
                                        }

                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                Snd.play(0);
                                                root.launch(game.id);
                                            }
                                        }
                                    }

                                    // Запуск
                                    Btn {
                                        label: "Играть";
                                        kind: 1;
                                        height: 30px;
                                        clicked => {
                                            Snd.play(0);
                                            root.launch(game.id);
                                        }
                                    }

                                    // Удаление
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        vertical-stretch: 0;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        background: del-touch.has-hover ? #F8717126 : transparent;
                                        animate background { duration: Theme.t-fast; }

                                        IconCross {
                                            width: 10px;
                                            height: 10px;
                                            c: del-touch.has-hover ? #FCA5A5 : Theme.text-muted;
                                            x: (parent.width - 10px) / 2;
                                            y: (parent.height - 10px) / 2;
                                        }

                                        del-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                Snd.play(2);
                                                root.remove(game.id);
                                            }
                                            Tooltip {
                                                text: @markdown("\{T.games_remove}");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ПРАВАЯ КОЛОНКА: Браузер серверов + Пинг дата-центров
            VerticalLayout {
                horizontal-stretch: 6;
                spacing: 12px;

                // Верхняя карточка: Браузер серверов
                Rectangle {
                    vertical-stretch: 3;
                    background: #12141C;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // Шапка тулбара серверов
                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;

                            Text {
                                text: "СЕРВЕРЫ";
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 0.6px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Фильтры регионов
                            HorizontalLayout {
                                spacing: 4px;
                                Btn { label: "Все"; kind: 2; active: root.region-filter == 0; height: 26px; clicked => { root.region-filter-set(0); } }
                                Btn { label: "EU"; kind: 2; active: root.region-filter == 1; height: 26px; clicked => { root.region-filter-set(1); } }
                                Btn { label: "US"; kind: 2; active: root.region-filter == 2; height: 26px; clicked => { root.region-filter-set(2); } }
                                Btn { label: "ASIA"; kind: 2; active: root.region-filter == 3; height: 26px; clicked => { root.region-filter-set(3); } }
                            }

                            Btn {
                                label: "Обновить";
                                kind: 1;
                                height: 28px;
                                enabled: !root.servers-busy;
                                clicked => { root.servers-refresh(""); }
                            }

                            Btn {
                                label: "Лучший";
                                kind: 0;
                                height: 28px;
                                enabled: !root.servers-busy && root.servers.length > 0;
                                clicked => { root.servers-best(""); }
                            }
                        }

                        if root.servers-msg != "" : Text {
                            text: root.servers-msg;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }

                        // Список серверов
                        if root.servers.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: root.servers-busy ? "Поиск доступных серверов…" : "Нажмите «Обновить» для поиска серверов";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.servers.length > 0 : Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: srv-col.preferred-height;

                            srv-col := VerticalLayout {
                                y: 0px;
                                width: parent.width;
                                height: self.preferred-height;
                                alignment: start;
                                spacing: 6px;

                                for s in root.servers : Rectangle {
                                    height: 44px;
                                    border-radius: 10px;
                                    background: #161822;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        // Бейдж пинга
                                        Rectangle {
                                            width: 60px;
                                            height: 22px;
                                            vertical-stretch: 0;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 6px;
                                            background: s.ping-kind == 0 ? #4ADE8020
                                                : s.ping-kind == 1 ? #FBBF2420
                                                : s.ping-kind == 2 ? #F8717120
                                                : #ffffff0d;

                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: s.ping;
                                                font-family: Theme.font-mono;
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: s.ping-kind == 0 ? Theme.success
                                                    : s.ping-kind == 1 ? Theme.warning
                                                    : s.ping-kind == 2 ? Theme.danger
                                                    : Theme.text-secondary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        // Регион
                                        Text {
                                            text: s.region;
                                            font-size: 12px;
                                            font-weight: 500;
                                            color: Theme.text-primary;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: left;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }

                                        // Игроки
                                        Text {
                                            text: s.players;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }

                                        // Копирование JobId
                                        Btn {
                                            label: "JobId";
                                            kind: 2;
                                            height: 28px;
                                            vertical-stretch: 0;
                                            y: (parent.height - self.height) / 2;
                                            clicked => {
                                                Snd.play(2);
                                                root.server-copy-id(s.id);
                                            }
                                        }

                                        // Войти
                                        Btn {
                                            label: "Войти";
                                            kind: 1;
                                            height: 28px;
                                            vertical-stretch: 0;
                                            y: (parent.height - self.height) / 2;
                                            clicked => {
                                                Snd.play(0);
                                                root.server-join(s.place, s.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Нижняя карточка: Пинг дата-центров
                Rectangle {
                    vertical-stretch: 2;
                    min-height: 125px;
                    background: #12141C;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            height: 28px;

                            Text {
                                text: "ПИНГ ДАТА-ЦЕНТРОВ";
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 0.6px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Btn {
                                label: root.ping-busy ? T.games_ping_testing : T.games_ping_test_btn;
                                kind: 1;
                                height: 28px;
                                enabled: !root.ping-busy;
                                clicked => { root.ping-test(); }
                            }
                        }

                        if root.region-pings.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: "Нажмите «Проверить пинг» для замера задержки";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.region-pings.length > 0 : Flickable {
                            vertical-stretch: 1;
                            content-width: self.width;
                            content-height: ping-col.preferred-height;

                            ping-col := VerticalLayout {
                                y: 0px;
                                width: parent.width;
                                height: self.preferred-height;
                                alignment: start;
                                spacing: 4px;

                                for rp in root.region-pings : Rectangle {
                                    height: 26px;
                                    border-radius: 6px;
                                    background: #161822;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Rectangle {
                                            width: 26px;
                                            height: 18px;
                                            vertical-stretch: 0;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 4px;
                                            background: #ffffff14;
                                            border-width: 1px;
                                            border-color: #ffffff20;

                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: rp.flag;
                                                font-family: Theme.font-mono;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: Theme.text-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: rp.name;
                                            font-size: 12px;
                                            color: Theme.text-primary;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: rp.ping;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: rp.ping-kind == 0 ? Theme.success : (rp.ping-kind == 1 ? Theme.warning : Theme.danger);
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

        // 3. ПОДВКЛАДКА 1: ГАЛЕРЕЯ СКРИНШОТОВ
        if root.active-tab == 1 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            // Левая колонка: список скриншотов
            Rectangle {
                horizontal-stretch: 4;
                background: #12141C;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        height: 28px;

                        Text {
                            text: "СНИМКИ (" + root.shots.length + ")";
                            font-family: Theme.font-mono;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.6px;
                            color: Theme.text-secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Btn {
                            label: T.screenshots_refresh;
                            kind: 1;
                            height: 28px;
                            clicked => { root.shot-refresh(); }
                        }
                    }

                    if root.shots.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: T.screenshots_empty;
                            font-size: 12px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.shots.length > 0 : Flickable {
                        vertical-stretch: 1;
                        content-width: self.width;
                        content-height: shots-col.preferred-height;

                        shots-col := VerticalLayout {
                            width: parent.width;
                            spacing: 6px;

                            for shot[idx] in root.shots : Rectangle {
                                height: 46px;
                                border-radius: 10px;
                                background: root.shot-selected == idx ? #96A6FF14 : (shot-touch.has-hover ? #1E212E : #161822);
                                border-width: 1px;
                                border-color: root.shot-selected == idx ? Theme.border-accent : Theme.border;
                                animate background { duration: Theme.t-fast; }

                                VerticalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 2px;
                                    alignment: center;

                                    Text {
                                        text: shot.name;
                                        font-size: 12px;
                                        font-weight: root.shot-selected == idx ? 600 : 400;
                                        color: root.shot-selected == idx ? Theme.text-primary : Theme.text-secondary;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: shot.date + " · " + shot.size;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        color: Theme.text-muted;
                                    }
                                }

                                shot-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        Snd.play(1);
                                        root.shot-select(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Правая колонка: предпросмотр и действия
            Rectangle {
                horizontal-stretch: 6;
                background: #12141C;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // Область предпросмотра
                    Rectangle {
                        vertical-stretch: 1;
                        background: #0D0E13;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        if root.shot-selected >= 0 : Image {
                            width: 100%;
                            height: 100%;
                            source: root.shot-preview-img;
                            image-fit: contain;
                        }

                        if root.shot-selected < 0 : Text {
                            width: 100%;
                            height: 100%;
                            text: "Выберите скриншот для предпросмотра";
                            font-size: 13px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Метаданные скриншота
                    if root.shot-selected >= 0 : HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: root.shot-preview-name;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.shot-preview-date + " · " + root.shot-preview-size;
                            font-family: Theme.font-mono;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }

                    // Статус
                    if root.shot-status != "" : Text {
                        text: root.shot-status;
                        font-size: 12px;
                        color: Theme.accent;
                        overflow: elide;
                    }

                    // Кнопки действий
                    HorizontalLayout {
                        spacing: 8px;

                        Btn {
                            label: T.screenshots_copy_discord;
                            kind: 0;
                            height: 34px;
                            enabled: root.shot-selected >= 0;
                            clicked => { root.shot-copy(root.shot-preview-path); }
                        }

                        Btn {
                            label: T.screenshots_open;
                            kind: 1;
                            height: 34px;
                            enabled: root.shot-selected >= 0;
                            clicked => { root.shot-open(root.shot-preview-path); }
                        }

                        Btn {
                            label: T.screenshots_open_folder;
                            kind: 1;
                            height: 34px;
                            clicked => { root.shot-folder(root.shot-preview-path); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Btn {
                            label: T.screenshots_delete;
                            kind: 3;
                            height: 34px;
                            enabled: root.shot-selected >= 0;
                            clicked => { root.shot-delete(root.shot-preview-path); }
                        }
                    }
                }
            }
        }
    }
}
