// Моды: папки-моды (тумблер/порядок/открыть), список включённых файлов,
// профили (комбобокс + действия). Диалоги — на уровне AppWindow.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { PageFade, Btn, IconBtn, GlyphBtn, Combo, Toggle } from "../widgets.slint";
import { ModRow, ModFileRow } from "../models.slint";

export component ModsPage inherits PageFade {
    in-out property <string> mods-path: "";
    in-out property <[ModRow]> mods-list: [];
    in-out property <string> mods-msg: "";
    in-out property <bool> mods-msg-err: false;
    in-out property <bool> apply-enabled: false;
    in-out property <bool> revert-enabled: false;
    in-out property <string> files-count: "";
    in-out property <[ModFileRow]> files: [];
    in-out property <[string]> profiles: [];
    in-out property <string> profile-sel-text;
    in-out property <int> profile-sel-index: -1;
    in-out property <bool> profile-sel-valid: false;
    in-out property <bool> profiles-empty: false;
    /// Открыт ли комбобокс профилей (для высоты скролла).
    in-out property <bool> profile-open: false;

    // Кастомизация клиента
    in-out property <int> death-sound-mode: 0;
    in-out property <string> death-sound-path: "";
    in-out property <int> cursor-mode: 0;
    in-out property <int> font-mode: 0;
    in-out property <string> font-path: "";

    in-out property <[string]> death-sound-options: [
        "Roblox (по умолчанию)",
        "Классический «OOF» (2006–2022)",
        "Minecraft (удар)",
        "Без звука (тишина)",
        "Свой аудиофайл…"
    ];
    in-out property <[string]> cursor-options: [
        "Стандартный Roblox (2020+)",
        "Ретро-указатель (2006–2013)",
        "Классический (2013–2020)",
        "Киберспорт / Прицел (точка)"
    ];
    in-out property <[string]> font-options: [
        "Roblox (Source Sans Pro)",
        "JetBrains Mono (моноширинный)",
        "Inter (гротеск)",
        "Unbounded (акцидентный)",
        "Свой файл шрифта…"
    ];

    pure function death-sound-label(mode: int, p: string) -> string {
        mode == 1 ? "Классический «OOF» (2006–2022)" :
        mode == 2 ? "Minecraft (удар)" :
        mode == 3 ? "Без звука (тишина)" :
        mode == 4 ? (p != "" ? ("Свой: " + p) : "Свой аудиофайл…") :
        "Roblox (по умолчанию)"
    }

    pure function cursor-label(mode: int) -> string {
        mode == 1 ? "Ретро-указатель (2006–2013)" :
        mode == 2 ? "Классический (2013–2020)" :
        mode == 3 ? "Киберспорт / Прицел (точка)" :
        "Стандартный Roblox (2020+)"
    }

    pure function font-label(mode: int, p: string) -> string {
        mode == 1 ? "JetBrains Mono (моноширинный)" :
        mode == 2 ? "Inter (гротеск)" :
        mode == 3 ? "Unbounded (акцидентный)" :
        mode == 4 ? (p != "" ? ("Свой: " + p) : "Свой файл шрифта…") :
        "Roblox (Source Sans Pro)"
    }

    callback death-sound-set(int);
    callback death-sound-pick();
    callback cursor-set(int);
    callback font-set(int);
    callback font-pick();

    callback open-folder();
    callback refresh();
    callback apply();
    callback revert();
    callback toggle-mod(string, bool);
    callback move-mod(string, int);
    callback open-mod-folder(string);
    callback profile-pick(int);
    callback profile-load();
    callback profile-save-as();
    callback profile-delete();
    callback profile-export();
    callback profile-import();

    property <length> files-h: root.mods-list.length == 0 ? 0px
        : root.files.length == 0 ? 60px
        : min(root.files.length * 22px, 340px);

    VerticalLayout {
        spacing: 0px;

        Text {
            text: T.mods_h1;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: 22px;
            letter-spacing: 0.5px;
            color: Theme.fg;
        }
        Rectangle { height: 5px; }
        Text {
            text: T.mods_sub;
            font-size: 12.5px;
            color: Theme.fg-dim;
        }
        Rectangle { height: 16px; }

        flick := Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: col.preferred-height;
            changed viewport-y => {
                if Dd.open {
                    Dd.open = false;
                }
            }

            col := VerticalLayout {
                width: 100%;
                spacing: 14px;
                padding-bottom: 24px;

                // ===== Кастомизация клиента (Звуки, Курсоры, Шрифты) =====
                c-cust := Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: #ffffff17;
                    border-radius: Theme.r-card;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: T.mods_customization_h1;
                                font-weight: 700;
                                font-size: 14px;
                                color: Theme.fg;
                            }
                            Text {
                                text: T.mods_customization_sub;
                                font-size: 11px;
                                color: Theme.fg-dim;
                            }
                        }

                        Rectangle { height: 1px; background: #ffffff0d; }

                        // 1. Звук смерти
                        HorizontalLayout {
                            spacing: 16px;
                            height: 34px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: T.mods_death_sound;
                                    font-weight: 600;
                                    font-size: 12.5px;
                                    color: Theme.fg;
                                }
                                Text {
                                    text: T.mods_death_sound_desc;
                                    font-size: 11px;
                                    color: Theme.fg-dim;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Combo {
                                    width: root.death-sound-mode == 4 ? 180px : 260px;
                                    dd-id: 300;
                                    items: root.death-sound-options;
                                    selected: root.death-sound-mode;
                                    current-text: root.death-sound-label(root.death-sound-mode, root.death-sound-path);
                                    pick(i) => {
                                        root.death-sound-set(i);
                                        if i == 4 { root.death-sound-pick(); }
                                    }
                                }

                                if root.death-sound-mode == 4 : Btn {
                                    label: "Обзор…";
                                    kind: 1;
                                    width: 72px;
                                    height: 32px;
                                    clicked => { root.death-sound-pick(); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #ffffff0d; }

                        // 2. Курсор мыши
                        HorizontalLayout {
                            spacing: 16px;
                            height: 34px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: T.mods_cursor;
                                    font-weight: 600;
                                    font-size: 12.5px;
                                    color: Theme.fg;
                                }
                                Text {
                                    text: T.mods_cursor_desc;
                                    font-size: 11px;
                                    color: Theme.fg-dim;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Combo {
                                    width: 260px;
                                    dd-id: 301;
                                    items: root.cursor-options;
                                    selected: root.cursor-mode;
                                    current-text: root.cursor-label(root.cursor-mode);
                                    pick(i) => { root.cursor-set(i); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #ffffff0d; }

                        // 3. Шрифт интерфейса
                        HorizontalLayout {
                            spacing: 16px;
                            height: 34px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: T.mods_font;
                                    font-weight: 600;
                                    font-size: 12.5px;
                                    color: Theme.fg;
                                }
                                Text {
                                    text: T.mods_font_desc;
                                    font-size: 11px;
                                    color: Theme.fg-dim;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                Combo {
                                    width: root.font-mode == 4 ? 180px : 260px;
                                    dd-id: 302;
                                    items: root.font-options;
                                    selected: root.font-mode;
                                    current-text: root.font-label(root.font-mode, root.font-path);
                                    pick(i) => {
                                        root.font-set(i);
                                        if i == 4 { root.font-pick(); }
                                    }
                                }

                                if root.font-mode == 4 : Btn {
                                    label: "Обзор…";
                                    kind: 1;
                                    width: 72px;
                                    height: 32px;
                                    clicked => { root.font-pick(); }
                                }
                            }
                        }
                    }
                }

                // ===== Действия =====
                c-act := Rectangle {
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: #ffffff17;
                    border-radius: Theme.r-card;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: T.mods_where;
                        font-weight: 600;
                        font-size: 13px;
                        height: 17px;
                        color: Theme.fg;
                    }
                    Text {
                        text: root.mods-path;
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        height: 15px;
                        color: Theme.fg-dimmer;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Btn {
                            label: T.mods_open_folder;
                            kind: 2;
                            width: 130px;
                            height: 30px;
                            clicked => { root.open-folder(); }
                        }
                        Btn {
                            label: T.mods_refresh;
                            kind: 2;
                            width: 100px;
                            height: 30px;
                            clicked => { root.refresh(); }
                        }
                        Btn {
                            label: T.mods_apply;
                            kind: 0;
                            width: 110px;
                            height: 30px;
                            enabled: root.apply-enabled;
                            clicked => { root.apply(); }
                        }
                        Btn {
                            label: T.mods_revert;
                            kind: 2;
                            width: 100px;
                            height: 30px;
                            enabled: root.revert-enabled;
                            clicked => { root.revert(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.mods-msg != "" : Text {
                        text: root.mods-msg;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        height: 18px;
                        color: root.mods-msg-err ? Theme.bad : Theme.good;
                        overflow: elide;
                    }
                }
            }

                // ===== Список модов =====
                c-list := Rectangle {
                    height: root.mods-list.length == 0
                        ? 60px
                        : 16px + root.mods-list.length * 36px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: #ffffff17;
                    border-radius: Theme.r-card;
                    clip: true;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                    if root.mods-list.length == 0 : Text {
                        padding: 16px;
                        text: T.mods_empty_managed;
                        font-size: 12px;
                        color: Theme.fg-dimmer;
                        wrap: word-wrap;
                    }

                    if root.mods-list.length > 0 : VerticalLayout {
                        padding: 8px;
                        spacing: 2px;

                    for m in root.mods-list : Rectangle {
                        height: 34px;
                        background: row-touch.has-hover ? Theme.glass-hover : transparent;
                        animate background { duration: Theme.t-fast; }

                        // Захват ховера строки — снизу, не перекрывает тумблер.
                        row-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                        }

                        // Тумблер вкл/выкл.
                        Toggle {
                            x: 10px;
                            y: 6px;
                            on: m.enabled;
                            toggled(v) => { root.toggle-mod(m.id, v); }
                        }

                        Text {
                            x: 56px;
                            y: 0;
                            width: 200px;
                            height: 34px;
                            text: m.id;
                            font-size: 13px;
                            color: Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            x: 260px;
                            y: 0;
                            width: parent.width - 260px - 110px;
                            height: 34px;
                            text: m.meta;
                            font-family: Theme.font-mono;
                            font-size: 11px;
                            color: Theme.fg-dimmer;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // Порядок и папка — справа (унифицированные 28×28).
                        GlyphBtn {
                            x: parent.width - 100px;
                            y: 3px;
                            glyph: "↑";
                            enabled: m.can-up;
                            tip: T.mods_up;
                            clicked => { root.move-mod(m.id, -1); }
                        }
                        GlyphBtn {
                            x: parent.width - 66px;
                            y: 3px;
                            glyph: "↓";
                            enabled: m.can-down;
                            tip: T.mods_down;
                            clicked => { root.move-mod(m.id, 1); }
                        }
                        IconBtn {
                            x: parent.width - 32px;
                            y: 3px;
                            icon: 1;
                            tip: T.mods_open_folder;
                            clicked => { root.open-mod-folder(m.id); }
                        }
                    }
                }
            }

                // ===== Файлы включённых модов =====
                if root.mods-list.length > 0 : c-files := Rectangle {
                    height: root.files.length == 0 ? 58px : (55px + root.files-h);
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: #ffffff17;
                    border-radius: Theme.r-card;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                    if root.files.length == 0 : Text {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: 26px;
                        text: T.mods_no_enabled;
                        font-size: 12px;
                        color: Theme.fg-dimmer;
                    }

                    if root.files.length > 0 : VerticalLayout {
                        padding: 16px;
                        spacing: 8px;

                    Text {
                        text: root.files-count;
                        font-family: Theme.font-mono;
                        font-size: 10px;
                        letter-spacing: 1.5px;
                        color: Theme.fg-dimmer;
                    }

                    fflick := Flickable {
                        height: root.files-h;
                        content-width: self.width;
                        content-height: root.files.length * 22px;

                        for f[i] in root.files : Rectangle {
                            x: 0;
                            y: i * 22px;
                            width: fflick.width;
                            height: 22px;

                            Text {
                                x: 0;
                                y: 0;
                                width: parent.width - 170px;
                                height: 22px;
                                text: f.rel;
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                color: Theme.fg;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                x: parent.width - 166px;
                                y: 0;
                                width: 76px;
                                height: 22px;
                                text: f.size;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                color: Theme.fg-dimmer;
                                vertical-alignment: center;
                            }
                            Text {
                                x: parent.width - 86px;
                                y: 0;
                                width: 86px;
                                height: 22px;
                                text: f.status-kind == 0 ? T.mods_st_applied
                                    : f.status-kind == 1 ? T.mods_st_missing
                                    : T.mods_st_clean;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                color: f.status-kind == 0 ? Theme.good
                                    : f.status-kind == 1 ? Theme.warn
                                    : Theme.fg-dimmer;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

                // ===== Профили =====
                c-prof := Rectangle {
                    height: root.profiles-empty ? 148px : 125px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: #ffffff17;
                    border-radius: Theme.r-card;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: T.mods_profiles;
                        font-family: Theme.font-mono;
                        font-size: 10px;
                        letter-spacing: 1.5px;
                        color: Theme.fg-dimmer;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        combo := Combo {
                            width: 240px;
                            dd-id: 200;
                            items: root.profiles;
                            selected: root.profile-sel-index;
                            current-text: root.profile-sel-text;
                            pick(i) => { root.profile-pick(i); }
                            open-changed(v) => { root.profile-open = v; }
                        }
                        Btn {
                            label: T.prof_load;
                            kind: 0;
                            width: 90px;
                            height: 30px;
                            enabled: root.profile-sel-valid;
                            clicked => { root.profile-load(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Btn {
                            label: T.prof_save_as;
                            kind: 2;
                            width: 126px;
                            height: 30px;
                            clicked => { root.profile-save-as(); }
                        }
                        Btn {
                            label: T.prof_delete;
                            kind: 2;
                            width: 90px;
                            height: 30px;
                            enabled: root.profile-sel-valid;
                            clicked => { root.profile-delete(); }
                        }
                        Btn {
                            label: T.prof_export;
                            kind: 2;
                            width: 96px;
                            height: 30px;
                            enabled: root.profile-sel-valid;
                            clicked => { root.profile-export(); }
                        }
                        Btn {
                            label: T.prof_import;
                            kind: 2;
                            width: 96px;
                            height: 30px;
                            clicked => { root.profile-import(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.profiles-empty : Text {
                        text: T.mods_profiles_empty;
                        font-size: 11px;
                        height: 15px;
                        color: Theme.fg-dimmer;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
}
