// О программе: версия, репозиторий, лицензия и карточка проверки обновлений.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { PageFade, Btn, ProgressBar } from "../widgets.slint";
import { IconStar } from "../icons.slint";

export component AboutPage inherits PageFade {
    in-out property <string> app-version;
    /// 0 — idle, 1 — проверяем, 2 — актуально, 3 — найдено, 4 — загрузка, 5 — ошибка.
    in-out property <int> update-kind: 0;
    in-out property <string> update-text: "";
    in-out property <string> update-notes: "";
    in-out property <float> update-pct: 0;

    callback check-updates();
    callback download();
    callback open-repo();

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: flick.width;
        content-height: col.preferred-height;

        col := VerticalLayout {
            width: flick.width;
            height: flick.content-height;
            spacing: 0px;

            Text {
                text: T.about_h1;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: 22px;
                letter-spacing: 0.5px;
                color: Theme.fg;
            }
            Rectangle { height: 5px; }
            Text {
                text: T.about_sub;
                font-size: 12.5px;
                color: Theme.fg-dim;
            }
            Rectangle { height: 16px; }

            // ===== О программе =====
            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    // Большая версия — фирменный дисплейный шрифт.
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        IconStar {
                            y: 2px;
                            width: 20px;
                            height: 20px;
                            c: Theme.fg;
                        }

                        Text {
                            text: root.app-version;
                            font-family: Theme.font-display;
                            font-weight: 700;
                            font-size: 22px;
                            color: Theme.fg;
                        }
                    }

                    Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: T.about_repo;
                                font-size: 13px;
                                color: Theme.fg-dim;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "mesorg-dev/ByteStrap";
                                font-family: Theme.font-mono;
                                font-size: 12px;
                                color: repo-touch.has-hover ? #ffffff : #ffffffb3;
                                vertical-alignment: center;
                            }
                        }
                        repo-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.open-repo(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: T.about_license;
                            font-size: 13px;
                            color: Theme.fg-dim;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "GPL-3.0";
                            font-family: Theme.font-mono;
                            font-size: 12px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { height: 14px; }

            // ===== Обновления =====
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    Text {
                        text: T.about_check_updates;
                        font-weight: 600;
                        font-size: 14px;
                        color: Theme.fg;
                    }

                    if root.update-kind == 0 || root.update-kind == 5 : Btn {
                        label: T.about_check_updates;
                        kind: 2;
                        width: 180px;
                        height: 32px;
                        clicked => { root.check-updates(); }
                    }

                    if root.update-kind == 5 : Text {
                        text: root.update-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: Theme.bad;
                        wrap: word-wrap;
                    }

                    if root.update-kind == 1 || root.update-kind == 2 : Text {
                        text: root.update-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: root.update-kind == 2 ? Theme.good : Theme.fg-dim;
                    }

                    if root.update-kind == 3 : Text {
                        text: root.update-text;
                        font-size: 13px;
                        color: Theme.fg;
                        wrap: word-wrap;
                    }

                    if root.update-kind == 3 && root.update-notes != "" : Text {
                        text: root.update-notes;
                        font-size: 11px;
                        color: Theme.fg-dimmer;
                        wrap: word-wrap;
                    }

                    if root.update-kind == 3 : Btn {
                        label: T.about_download;
                        kind: 0;
                        width: 180px;
                        height: 36px;
                        clicked => { root.download(); }
                    }

                    if root.update-kind == 4 : Text {
                        text: root.update-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: Theme.fg-dim;
                    }

                    if root.update-kind == 4 : ProgressBar {
                        value: root.update-pct;
                    }
                }
            }
        }
    }
}
