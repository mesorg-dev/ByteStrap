// О программе: версия, репозиторий, лицензия и карточка проверки обновлений.

import { Theme } from "../theme.slint";
import { T } from "../i18n.slint";
import { Snd } from "../snd.slint";
import { PageFade, Btn, ProgressBar } from "../widgets.slint";
import { IconStar, IconExternal } from "../icons.slint";

export component AboutPage inherits PageFade {
    in-out property <string> app-version;
    /// 0 — idle, 1 — проверяем, 2 — актуально, 3 — найдено, 4 — загрузка, 5 — ошибка.
    in-out property <int> update-kind: 0;
    in-out property <string> update-text: "";
    in-out property <string> update-notes: "";
    in-out property <float> update-pct: 0;

    callback check-updates();
    callback download();
    callback open-repo();
    callback open-tg();

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: flick.width;
        content-height: col.preferred-height;

        col := VerticalLayout {
            width: flick.width;
            height: flick.content-height;
            spacing: 0px;

            Text {
                text: T.about_h1;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: 22px;
                letter-spacing: 0.5px;
                color: Theme.fg;
            }
            Rectangle { height: 5px; }
            Text {
                text: T.about_sub;
                font-size: 12.5px;
                color: Theme.fg-dim;
            }
            Rectangle { height: 16px; }

            // ===== О программе =====
            Rectangle {
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    // Большая версия — фирменный дисплейный шрифт.
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        IconStar {
                            y: 2px;
                            width: 20px;
                            height: 20px;
                            c: Theme.accent;
                        }

                        Text {
                            text: root.app-version;
                            font-family: Theme.font-display;
                            font-weight: 700;
                            font-size: 22px;
                            color: Theme.fg;
                        }
                    }

                    HorizontalLayout {
                        height: 30px;

                        Text {
                            text: T.about_repo;
                            font-size: 13px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        repo-btn := Rectangle {
                            width: repo-layout.preferred-width;
                            height: 28px;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            border-radius: 14px;
                            background: repo-touch.has-hover ? #FFFFFF14 : #FFFFFF08;
                            border-width: 1px;
                            border-color: repo-touch.has-hover ? #FFFFFF33 : #FFFFFF14;
                            animate background { duration: Theme.t-fast; }
                            animate border-color { duration: Theme.t-fast; }

                            repo-layout := HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: "mesorg-dev/ByteStrap";
                                    font-family: Theme.font-mono;
                                    font-size: 12px;
                                    color: repo-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }

                                IconExternal {
                                    width: 12px;
                                    height: 12px;
                                    c: repo-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            repo-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    Snd.play(0);
                                    root.open-repo();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 30px;

                        Text {
                            text: T.about_tg;
                            font-size: 13px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        tg-btn := Rectangle {
                            width: tg-layout.preferred-width;
                            height: 28px;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            border-radius: 14px;
                            background: tg-touch.has-hover ? #FFFFFF14 : #FFFFFF08;
                            border-width: 1px;
                            border-color: tg-touch.has-hover ? #FFFFFF33 : #FFFFFF14;
                            animate background { duration: Theme.t-fast; }
                            animate border-color { duration: Theme.t-fast; }

                            tg-layout := HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: "@mesorgdev";
                                    font-family: Theme.font-mono;
                                    font-size: 12px;
                                    color: tg-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                }

                                IconExternal {
                                    width: 12px;
                                    height: 12px;
                                    c: tg-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            tg-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                mouse-cursor: pointer;
                                clicked => {
                                    Snd.play(0);
                                    root.open-tg();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 30px;

                        Text {
                            text: T.about_license;
                            font-size: 13px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            width: lic-layout.preferred-width;
                            height: 26px;
                            horizontal-stretch: 0;
                            vertical-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            border-radius: 8px;
                            background: #FFFFFF08;
                            border-width: 1px;
                            border-color: #FFFFFF14;

                            lic-layout := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;

                                Text {
                                    text: "GPL-3.0";
                                    font-family: Theme.font-mono;
                                    font-size: 12px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { height: 14px; }

            // ===== Обновления =====
            Rectangle {
                vertical-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: #ffffff17;
                border-radius: Theme.r-card;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                drop-shadow-offset-y: 4px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    Text {
                        text: T.about_check_updates;
                        font-weight: 600;
                        font-size: 14px;
                        color: Theme.fg;
                    }

                    if root.update-kind == 0 || root.update-kind == 5 : Btn {
                        label: T.about_check_updates;
                        kind: 2;
                        width: 180px;
                        height: 32px;
                        clicked => { root.check-updates(); }
                    }

                    if root.update-kind == 5 : Text {
                        text: root.update-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: Theme.bad;
                        wrap: word-wrap;
                    }

                    if root.update-kind == 1 || root.update-kind == 2 : Text {
                        text: root.update-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: root.update-kind == 2 ? Theme.good : Theme.fg-dim;
                    }

                    if root.update-kind == 3 : Text {
                        text: root.update-text;
                        font-size: 13px;
                        color: Theme.fg;
                        wrap: word-wrap;
                    }

                    if root.update-kind == 3 && root.update-notes != "" : Text {
                        text: root.update-notes;
                        font-size: 11px;
                        color: Theme.fg-dimmer;
                        wrap: word-wrap;
                    }

                    if root.update-kind == 3 : Btn {
                        label: T.about_download;
                        kind: 0;
                        width: 180px;
                        height: 36px;
                        clicked => { root.download(); }
                    }

                    if root.update-kind == 4 : Text {
                        text: root.update-text;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                        color: Theme.fg-dim;
                    }

                    if root.update-kind == 4 : ProgressBar {
                        value: root.update-pct;
                    }
                }
            }
        }
    }
}
