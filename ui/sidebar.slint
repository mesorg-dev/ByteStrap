// Левый сайдбар: звёздная навигация — плавающий индикатор скользит между
// пунктами, активный пункт подсвечен холодным стеклом. Футер — пульс.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { Snd } from "snd.slint";
import { IconHome, IconSliders, IconLayers, IconWrench, IconTerminal, IconGear, IconInfo } from "icons.slint";

component NavItem inherits Rectangle {
    in-out property <int> kind;
    in-out property <bool> active: false;
    in-out property <string> label;
    callback clicked;

    height: Theme.nav-item-h;
    border-radius: Theme.r-soft;
    background: root.active
        ? Theme.glass
        : (touch.has-hover ? #ffffff06 : transparent);
    animate background { duration: Theme.t-fast; }

    // Иконка по номеру пункта.
    if root.kind == 0 : IconHome {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 1 : IconSliders {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 2 : IconLayers {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 3 : IconWrench {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 4 : IconTerminal {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 5 : IconGear {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 6 : IconInfo {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }

    Text {
        x: 45px;
        y: 0;
        width: parent.width - 55px;
        height: parent.height;
        text: root.label;
        font-size: 12.5px;
        font-weight: root.active ? 600 : 400;
        letter-spacing: 0.3px;
        color: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dim);
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            Snd.play(2);
            root.clicked();
        }
    }
}

export component SideBar inherits Rectangle {
    /// Активная страница (0..6).
    in-out property <int> page: 0;
    callback navigate(int);

    background: transparent;

    // Скользящий индикатор активного пункта: белая линия с ореолом,
    // которая плавно переезжает при смене страницы.
    Rectangle {
        x: 0;
        y: 18px + root.page * Theme.nav-step + (Theme.nav-item-h - 20px) / 2;
        animate y { duration: Theme.t-mid; easing: ease-out; }
        width: 3px;
        height: 20px;
        border-radius: 1.5px;
        background: #ffffff;
        drop-shadow-blur: 7px;
        drop-shadow-color: #ffffff59;
    }

    NavItem {
        x: 12px;
        y: 18px;
        width: parent.width - 24px;
        kind: 0;
        label: T.nav_home;
        active: root.page == 0;
        clicked => { root.navigate(0); }
    }
    NavItem {
        x: 12px;
        y: 68px;
        width: parent.width - 24px;
        kind: 1;
        label: T.nav_flags;
        active: root.page == 1;
        clicked => { root.navigate(1); }
    }
    NavItem {
        x: 12px;
        y: 118px;
        width: parent.width - 24px;
        kind: 2;
        label: T.nav_versions;
        active: root.page == 2;
        clicked => { root.navigate(2); }
    }
    NavItem {
        x: 12px;
        y: 168px;
        width: parent.width - 24px;
        kind: 3;
        label: T.nav_mods;
        active: root.page == 3;
        clicked => { root.navigate(3); }
    }
    NavItem {
        x: 12px;
        y: 218px;
        width: parent.width - 24px;
        kind: 4;
        label: T.nav_logs;
        active: root.page == 4;
        clicked => { root.navigate(4); }
    }
    NavItem {
        x: 12px;
        y: 268px;
        width: parent.width - 24px;
        kind: 5;
        label: T.nav_settings;
        active: root.page == 5;
        clicked => { root.navigate(5); }
    }
    NavItem {
        x: 12px;
        y: 318px;
        width: parent.width - 24px;
        kind: 6;
        label: T.nav_about;
        active: root.page == 6;
        clicked => { root.navigate(6); }
    }

    // Футер: пульсирующая звезда готовности.
    Rectangle {
        x: 16px;
        y: parent.height - 34px;
        width: parent.width - 32px;
        height: 24px;

        Rectangle {
            x: 0;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.good;
            drop-shadow-blur: 6px;
            drop-shadow-color: #8ed6a455;
            opacity: 0.55 + 0.45 * Theme.twinkle(13.3, animation-tick() / 1ms);
        }

        Text {
            x: 15px;
            y: 0;
            width: parent.width - 15px;
            height: parent.height;
            text: T.footer_ready;
            font-family: Theme.font-mono;
            font-size: 10.5px;
            letter-spacing: 1px;
            color: Theme.fg-dimmer;
            vertical-alignment: center;
        }
    }

    // Разделитель с контентом.
    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: #ffffff0f;
    }
}
