// Левый сайдбар: звёздная навигация — плавающий индикатор скользит между
// пунктами, активный пункт подсвечен холодным стеклом. Футер — пульс.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { Snd } from "snd.slint";
import { IconHome, IconGamepad, IconSliders, IconLayers, IconWrench, IconTerminal, IconGear, IconInfo } from "icons.slint";

component NavItem inherits Rectangle {
    in-out property <int> kind;
    in-out property <bool> active: false;
    in-out property <string> label;
    callback clicked;

    height: Theme.nav-item-h;
    border-radius: Theme.r-soft;
    background: root.active
        ? Theme.glass
        : (touch.has-hover ? #ffffff06 : transparent);
    animate background { duration: Theme.t-fast; }

    // Иконка по номеру пункта.
    if root.kind == 0 : IconHome {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 1 : IconGamepad {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 2 : IconSliders {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 3 : IconLayers {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 4 : IconWrench {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 5 : IconTerminal {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 6 : IconGear {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }
    if root.kind == 7 : IconInfo {
        x: 15px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dimmer);
    }

    Text {
        x: 45px;
        y: 0;
        width: parent.width - 55px;
        height: parent.height;
        text: root.label;
        font-size: 12.5px;
        font-weight: root.active ? 600 : 400;
        letter-spacing: 0.3px;
        color: root.active ? Theme.fg : (touch.has-hover ? Theme.fg-dim : Theme.fg-dim);
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            Snd.play(2);
            root.clicked();
        }
    }
}

export component SideBar inherits Rectangle {
    /// Активная страница (0..7).
    in-out property <int> page: 0;
    /// Пункт «Логи» можно скрыть в настройках.
    in-out property <bool> show-logs: true;
    callback navigate(int);

    /// Позиция пункта: скрытые «Логи» сдвигают «Настройки» и «О программе».
    pure function item-y(kind: int) -> length {
        (18px + kind * Theme.nav-step)
            - ((!root.show-logs && kind > 5) ? Theme.nav-step : 0px)
    }
    /// Скользящий индикатор: индекс видимого пункта для активной страницы.
    pure function ind-y() -> length {
        (18px + (root.page - ((!root.show-logs && root.page > 5) ? 1 : 0)) * Theme.nav-step
            + (Theme.nav-item-h - 20px) / 2)
    }

    background: transparent;

    // Скользящий индикатор активного пункта: белая линия с ореолом,
    // которая плавно переезжает при смене страницы.
    Rectangle {
        x: 0;
        y: root.ind-y();
        animate y { duration: Theme.t-mid; easing: ease-out; }
        width: 3px;
        height: 20px;
        border-radius: 1.5px;
        background: #ffffff;
        drop-shadow-blur: 7px;
        drop-shadow-color: #ffffff59;
    }

    NavItem {
        x: 12px;
        y: root.item-y(0);
        width: parent.width - 24px;
        kind: 0;
        label: T.nav_home;
        active: root.page == 0;
        clicked => { root.navigate(0); }
    }
    NavItem {
        x: 12px;
        y: root.item-y(1);
        width: parent.width - 24px;
        kind: 1;
        label: T.nav_games;
        active: root.page == 1;
        clicked => { root.navigate(1); }
    }
    NavItem {
        x: 12px;
        y: root.item-y(2);
        width: parent.width - 24px;
        kind: 2;
        label: T.nav_flags;
        active: root.page == 2;
        clicked => { root.navigate(2); }
    }
    NavItem {
        x: 12px;
        y: root.item-y(3);
        width: parent.width - 24px;
        kind: 3;
        label: T.nav_versions;
        active: root.page == 3;
        clicked => { root.navigate(3); }
    }
    NavItem {
        x: 12px;
        y: root.item-y(4);
        width: parent.width - 24px;
        kind: 4;
        label: T.nav_mods;
        active: root.page == 4;
        clicked => { root.navigate(4); }
    }
    if root.show-logs : NavItem {
        x: 12px;
        y: root.item-y(5);
        width: parent.width - 24px;
        kind: 5;
        label: T.nav_logs;
        active: root.page == 5;
        clicked => { root.navigate(5); }
    }
    NavItem {
        x: 12px;
        y: root.item-y(6);
        width: parent.width - 24px;
        kind: 6;
        label: T.nav_settings;
        active: root.page == 6;
        clicked => { root.navigate(6); }
    }
    NavItem {
        x: 12px;
        y: root.item-y(7);
        width: parent.width - 24px;
        kind: 7;
        label: T.nav_about;
        active: root.page == 7;
        clicked => { root.navigate(7); }
    }

    // Футер: пульсирующая звезда готовности.
    Rectangle {
        x: 16px;
        y: parent.height - 34px;
        width: parent.width - 32px;
        height: 24px;

        Rectangle {
            x: 0;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Theme.good;
            drop-shadow-blur: 6px;
            drop-shadow-color: #8ed6a455;
            opacity: 0.55 + 0.45 * Theme.twinkle(13.3, animation-tick() / 1ms);
        }

        Text {
            x: 15px;
            y: 0;
            width: parent.width - 15px;
            height: parent.height;
            text: T.footer_ready;
            font-family: Theme.font-mono;
            font-size: 10.5px;
            letter-spacing: 1px;
            color: Theme.fg-dimmer;
            vertical-alignment: center;
        }
    }

    // Разделитель с контентом.
    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: #ffffff0f;
    }
}
