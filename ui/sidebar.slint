// Левый сайдбар: навигация с иконками, индикатор активной страницы, футер.

import { Theme } from "theme.slint";
import { T } from "i18n.slint";
import { IconHome, IconSliders, IconLayers, IconWrench, IconTerminal, IconGear, IconInfo } from "icons.slint";

component NavItem inherits Rectangle {
    in-out property <int> kind;
    in-out property <bool> active: false;
    in-out property <string> label;
    callback clicked;

    height: Theme.nav-item-h;
    border-radius: Theme.r-soft;
    background: root.active
        ? Theme.line-soft
        : (touch.has-hover ? Theme.line-soft.transparentize(0.45) : transparent);
    animate background { duration: 120ms; }

    // Активный индикатор слева.
    Rectangle {
        visible: root.active;
        x: 0;
        y: 10px;
        width: 2px;
        height: 26px;
        border-radius: 1px;
        background: Theme.fg;
    }

    // Иконка по номеру пункта.
    if root.kind == 0 : IconHome {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }
    if root.kind == 1 : IconSliders {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }
    if root.kind == 2 : IconLayers {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }
    if root.kind == 3 : IconWrench {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }
    if root.kind == 4 : IconTerminal {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }
    if root.kind == 5 : IconGear {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }
    if root.kind == 6 : IconInfo {
        x: 14px;
        y: (parent.height - 18px) / 2;
        c: root.active ? Theme.fg : Theme.fg-dimmer;
    }

    Text {
        x: 44px;
        y: 0;
        width: parent.width - 54px;
        height: parent.height;
        text: root.label;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
        color: root.active ? Theme.fg : Theme.fg-dim;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component SideBar inherits Rectangle {
    /// Активная страница (0..6).
    in-out property <int> page: 0;
    callback navigate(int);

    background: Theme.sidebar;

    // Разделитель с контентом.
    Rectangle {
        x: parent.width - 1px;
        y: 0;
        width: 1px;
        height: parent.height;
        background: Theme.line;
    }

    NavItem {
        x: 12px;
        y: 18px;
        width: parent.width - 24px;
        kind: 0;
        label: T.nav_home;
        active: root.page == 0;
        clicked => { root.navigate(0); }
    }
    NavItem {
        x: 12px;
        y: 68px;
        width: parent.width - 24px;
        kind: 1;
        label: T.nav_flags;
        active: root.page == 1;
        clicked => { root.navigate(1); }
    }
    NavItem {
        x: 12px;
        y: 118px;
        width: parent.width - 24px;
        kind: 2;
        label: T.nav_versions;
        active: root.page == 2;
        clicked => { root.navigate(2); }
    }
    NavItem {
        x: 12px;
        y: 168px;
        width: parent.width - 24px;
        kind: 3;
        label: T.nav_mods;
        active: root.page == 3;
        clicked => { root.navigate(3); }
    }
    NavItem {
        x: 12px;
        y: 218px;
        width: parent.width - 24px;
        kind: 4;
        label: T.nav_logs;
        active: root.page == 4;
        clicked => { root.navigate(4); }
    }
    NavItem {
        x: 12px;
        y: 268px;
        width: parent.width - 24px;
        kind: 5;
        label: T.nav_settings;
        active: root.page == 5;
        clicked => { root.navigate(5); }
    }
    NavItem {
        x: 12px;
        y: 318px;
        width: parent.width - 24px;
        kind: 6;
        label: T.nav_about;
        active: root.page == 6;
        clicked => { root.navigate(6); }
    }

    // Футер: индикатор готовности.
    Rectangle {
        x: 16px;
        y: parent.height - 34px;
        width: parent.width - 32px;
        height: 24px;

        Rectangle {
            x: 0;
            y: 9px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.good;
        }

        Text {
            x: 14px;
            y: 0;
            width: parent.width - 14px;
            height: parent.height;
            text: T.footer_ready;
            font-family: Theme.font-mono;
            font-size: 11px;
            color: Theme.fg-dimmer;
            vertical-alignment: center;
        }
    }
}
