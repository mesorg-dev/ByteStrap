// Общие модели данных, которые контроллер кладёт в свойства AppWindow.

export struct LogLine {
    time: string,
    level: int,
    text: string,
    zebra: bool,
}

export struct PlaceRow {
    id: string,
    name: string,
    duration: string,
    icon: image,
    has-icon: bool,
}

/// Строка на странице Games: недавнее/избранное место Roblox.
export struct GameRow {
    id: string,
    name: string,
    visits: string,
    /// «12.11» — день последнего запуска.
    last: string,
    fav: bool,
    alt: bool,
    /// true — не удаётся разобрать placeId (показываем как текст).
    bad: bool,
}

/// Публичный сервер места (Games → список серверов).
export struct ServerRow {
    /// JobId сервера.
    id: string,
    /// placeId места.
    place: string,
    /// «12 / 50».
    players: string,
    /// «45 мс» или «—».
    ping: string,
    /// Регион: «EU: Франкфурт».
    region: string,
    /// 0 — отличный (<80), 1 — средний (80-150), 2 — плохой (>150), 3 — неизвестно.
    ping-kind: int,
}

/// Строка проверки пинга региона Roblox.
export struct RegionPingRow {
    flag: string,
    name: string,
    ping: string,
    ping_kind: int,
}

/// Снимок экрана Roblox (Games → Галерея скриншотов).
export struct ScreenshotRow {
    path: string,
    name: string,
    date: string,
    size: string,
    selected: bool,
}

export struct ModRow {
    id: string,
    /// «файлов: N · размер» — уже отформатировано контроллером.
    meta: string,
    enabled: bool,
    can-up: bool,
    can-down: bool,
}

export struct ModFileRow {
    rel: string,
    size: string,
    /// 0 — применён, 1 — не применён, 2 — файл клиента.
    status-kind: int,
}

export struct FlagRow {
    /// Индекс в таблице контроллера (не в отфильтрованной выборке).
    idx: int,
    name: string,
    value: string,
    /// «категория · описание» из реестра (пусто — флаг неизвестен).
    desc: string,
    selected: bool,
    /// Полосатость строки (i % 2).
    alt: bool,
    /// Флаг в официальном allowlist Roblox — иначе клиент его игнорирует.
    works: bool,
}

export struct PresetRow {
    label: string,
    desc: string,
    /// 0 — выпадающий список, 1 — тумблер.
    kind: int,
    options: [string],
    selected: int,
    /// Локализованный текущий вариант для закрытого комбобокса.
    current: string,
    on: bool,
    /// Все флаги пресета в allowlist Roblox.
    works: bool,
}

export struct ChatPeerRow {
    user-id: string,
    username: string,
    display-name: string,
    is-self: bool,
    is-muted: bool,
}

export struct ChatMsgRow {
    user-id: string,
    username: string,
    display-name: string,
    text: string,
    time: string,
    is-self: bool,
}
